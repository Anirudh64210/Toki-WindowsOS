<Window x:Class="Toki.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toki"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        Background="{StaticResource Surface}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}"
        Width="120" Height="40" KeyDown="OnKeyDown">
    <!-- Opaque window clipped to a rounded region (see code-behind). The Border
         draws the matching rounded fill + subtle edge; Host stretches the current
         view to fill the window so content never overflows/clips. -->
    <Border x:Name="Root" Background="{StaticResource Surface}"
            BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="22">
        <!-- Grid stretches its child view to fill the window exactly, so content
             wraps/scrolls within bounds instead of overflowing and clipping. -->
        <Grid x:Name="Host" ClipToBounds="True" RenderTransformOrigin="0.5,0.9">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="HostScale"/>
            </Grid.RenderTransform>
        </Grid>
    </Border>
</Window>
