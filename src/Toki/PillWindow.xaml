<Window x:Class="Toki.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Toki.Controls"
        Title="Toki"
        Width="500" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" KeyDown="OnKeyDown">
    <Grid>
        <!-- Toki peeks over the top edge of the collapsed pill (behind the shell). -->
        <controls:TokiBlob x:Name="PeekBlob" Width="34" Height="30"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,36" Opacity="0" IsHitTestVisible="False"/>

        <Border x:Name="Shell"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="{StaticResource Surface}" CornerRadius="15"
                Width="112" Height="30" RenderTransformOrigin="0.5,1"
                MouseEnter="OnShellMouseEnter" MouseLeave="OnShellMouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShellSlide" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <ContentControl x:Name="Host" Focusable="False"/>
        </Border>
    </Grid>
</Window>
