<UserControl x:Class="Toki.Controls.TokiBlob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scales to whatever Width/Height the host sets, keeping proportions. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Width="120" Height="106">
            <Grid.RenderTransform>
                <!-- Squash/stretch from the base, so Toki "breathes". -->
                <ScaleTransform x:Name="Breathe" CenterX="60" CenterY="106"/>
            </Grid.RenderTransform>

            <!-- Body: a soft pink CLOUD, matching the Toki-ProductDesign logo — a wide rounded base
                 with three humps on top (union of ellipses), NOT a single oval. -->
            <Path Fill="#F48AAE">
                <Path.Data>
                    <GeometryGroup FillRule="Nonzero">
                        <EllipseGeometry Center="60,67" RadiusX="58" RadiusY="37"/>
                        <EllipseGeometry Center="30,52" RadiusX="25" RadiusY="25"/>
                        <EllipseGeometry Center="61,37" RadiusX="33" RadiusY="33"/>
                        <EllipseGeometry Center="91,52" RadiusX="25" RadiusY="25"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
            <!-- Cheek blush -->
            <Ellipse Width="18" Height="12" Fill="#EC6E99" Opacity="0.55"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="12,26,0,0"/>
            <Ellipse Width="18" Height="12" Fill="#EC6E99" Opacity="0.55"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,26,12,0"/>

            <!-- Eyes -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="0,-4,0,0">
                <Border x:Name="LeftEye" Width="15" Height="34" Background="White"
                        CornerRadius="7.5" Margin="0,0,13,0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LeftBlink"/>
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="RightEye" Width="15" Height="34" Background="White"
                        CornerRadius="7.5" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="RightBlink"/>
                    </Border.RenderTransform>
                </Border>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
