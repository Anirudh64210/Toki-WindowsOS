<UserControl x:Class="Toki.Controls.TokiBlob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Scales to whatever Width/Height the host sets, keeping proportions. -->
    <Viewbox Stretch="Uniform">
        <!-- A little padding around the 120x106 art so the soft drop shadow isn't clipped. -->
        <Grid Width="132" Height="120">
            <Grid x:Name="Root" Width="120" Height="106" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.9">
                <Grid.RenderTransform>
                    <!-- Breathe = squash/stretch · Hop = vertical bounce · Tilt = wobble/spin. Each animation
                         targets its own transform so they compose without fighting. -->
                    <TransformGroup>
                        <ScaleTransform x:Name="Breathe" CenterX="60" CenterY="106"/>
                        <TranslateTransform x:Name="Hop"/>
                        <RotateTransform x:Name="Tilt" CenterX="60" CenterY="74"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Body: the soft BLUE cloud (the 2026-08 redesign - figma "Charecters", 325:278; it was
                     pink before). A vertical gradient (airy sky top → saturated blue base) keeps the puffy,
                     dimensional look. NO DropShadowEffect anywhere in this control: the body breathes and
                     the eyes blink CONSTANTLY, and an Effect re-renders its whole subtree in software on
                     every animated frame (the motion-and-feel skill, rule 1.3) - it was why the mascot
                     rendered "hard". The lift comes from the cheap gradient ellipse below instead. -->
                <Ellipse Width="96" Height="22" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-6">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4D3E86D6" Offset="0.0"/>
                            <GradientStop Color="#003E86D6" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.42,1">
                            <GradientStop Color="#EAF6FF" Offset="0.0"/>
                            <GradientStop Color="#A9DCFB" Offset="0.40"/>
                            <GradientStop Color="#6EBCF6" Offset="0.72"/>
                            <GradientStop Color="#3D9BEA" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Data>
                        <GeometryGroup FillRule="Nonzero">
                            <EllipseGeometry Center="60,67" RadiusX="58" RadiusY="37"/>
                            <EllipseGeometry Center="30,52" RadiusX="25" RadiusY="25"/>
                            <EllipseGeometry Center="61,37" RadiusX="33" RadiusY="33"/>
                            <EllipseGeometry Center="91,52" RadiusX="25" RadiusY="25"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>

                <!-- Glossy top highlight: a soft white sheen near the crown, so light reads as coming from
                     above. Purely decorative (never hit-tested). -->
                <Ellipse Width="52" Height="30" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,6,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.4,0.3" Center="0.4,0.3" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#73FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Cheek blush - a cool blue now, barely-there, so the face still has warmth without
                     fighting the blue body. -->
                <Ellipse Width="17" Height="11" Fill="#5FA8E8" Opacity="0.35" IsHitTestVisible="False"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,28,0,0"/>
                <Ellipse Width="17" Height="11" Fill="#5FA8E8" Opacity="0.35" IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,28,14,0"/>

                <!-- Eyes: WHITE rounded pills on the blue body (the redesign inverts them - they were
                     near-black on pink). Each has a scale transform so they blink. The "seated in the
                     face" depth is a static darker pill BEHIND each eye, offset 1.5px down - the same
                     read as the old per-eye DropShadowEffect at none of its per-frame software cost.
                     The whole pair also carries a Gaze translate so Toki can glance aside (fidget). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,-4,0,0">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="Gaze"/></StackPanel.RenderTransform>
                    <!-- The blink transform sits on the GRID so the seat closes with the eye (a seat
                         that stayed open would flash as a dark pill mid-blink). -->
                    <Grid Margin="0,0,13,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="LeftBlink"/></Grid.RenderTransform>
                        <Border Width="16" Height="30" Background="#592F7BC4" CornerRadius="8" Margin="0,3,0,-3"/>
                        <Border x:Name="LeftEye" Width="16" Height="30" Background="#FAFDFF" CornerRadius="8"/>
                    </Grid>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="RightBlink"/></Grid.RenderTransform>
                        <Border Width="16" Height="30" Background="#592F7BC4" CornerRadius="8" Margin="0,3,0,-3"/>
                        <Border x:Name="RightEye" Width="16" Height="30" Background="#FAFDFF" CornerRadius="8"/>
                    </Grid>
                </StackPanel>

                <!-- ── Mood overlays (the redesign's Characters row, 348:5426-5435) ──
                     Each mood shows ONE overlay; SetMood in code owns visibility + motion. -->

                <!-- THINKING: a little speech bubble with three dots, at the cloud's right shoulder. -->
                <Border x:Name="ThinkBubble" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#F2FFFFFF" CornerRadius="9" Padding="7,4"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot1" Width="4.5" Height="4.5" Fill="#4A9BE8" Margin="0,0,3,0"/>
                        <Ellipse x:Name="Dot2" Width="4.5" Height="4.5" Fill="#4A9BE8" Margin="0,0,3,0"/>
                        <Ellipse x:Name="Dot3" Width="4.5" Height="4.5" Fill="#4A9BE8"/>
                    </StackPanel>
                </Border>

                <!-- WRITING: a pen at the cloud's right paw, nib down, gently scribbling. -->
                <TextBlock x:Name="Pen" Visibility="Collapsed" IsHitTestVisible="False"
                           Text="&#x270E;" FontSize="26" Foreground="#2E6FB2"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,10"
                           RenderTransformOrigin="0.8,0.9">
                    <TextBlock.RenderTransform><RotateTransform x:Name="PenTilt" Angle="105"/></TextBlock.RenderTransform>
                </TextBlock>

                <!-- HAPPY: sparkles around the crown (the eyes squint via their own transforms). -->
                <Canvas x:Name="Sparkles" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Canvas.Left="8"  Canvas.Top="6"  Text="&#x2726;" FontSize="13" Foreground="#F5C56B" Opacity="0.95"/>
                    <TextBlock Canvas.Left="96" Canvas.Top="0"  Text="&#x2726;" FontSize="17" Foreground="#F5C56B" Opacity="0.95"/>
                    <TextBlock Canvas.Left="104" Canvas.Top="34" Text="&#x2726;" FontSize="10" Foreground="#F5C56B" Opacity="0.85"/>
                </Canvas>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
