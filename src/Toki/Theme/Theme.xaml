<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Toki.Theme">

    <!-- ════════════════════════════════════════════════════════════════════════════
         THEMEABLE BRUSHES, with the DARK defaults below. The light/dark toggle
         (ThemeManager.Apply) REPLACES each brush in the application resources with a fresh
         one - it does NOT mutate these in place (see ARCHITECTURE "replace the brush, don't
         mutate it") - so only DynamicResource consumers recolour live; code-built UI that
         captured a brush via FindResource must rebuild on ThemeChanged. ThemeManager.Palette
         is the single source of truth for the dark↔light values; add new colours there as a
         Color+brush pair, not only here.
         ════════════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Surface" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Chip" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="TextSoft" Color="#DDDDDB"/>
    <SolidColorBrush x:Key="TextDim" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="Ink" Color="#141414"/>
    <SolidColorBrush x:Key="Notch" Color="#000000"/>
    <SolidColorBrush x:Key="NotchGlass" Color="#BF0F0F13"/>  <!-- glassier: more of the desktop shows through -->
    <SolidColorBrush x:Key="NotchBorder" Color="#33000000"/>
    <SolidColorBrush x:Key="WhiteBtn" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="CtaText" Color="#141414"/>
    <!-- Hover / press wash. 22% white, not 12%: the notch is pitch black, and 12% white over #000 is
         RGB ~31 - about 1.15:1 contrast, which nobody can see. The buttons were highlighting across
         their whole box all along; there was nothing visible to show for it. Keep these in step with
         ThemeManager.Palette, which is the source of truth for the light values. -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="PressOverlay" Color="#57FFFFFF"/>
    <SolidColorBrush x:Key="Hairline" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBorder" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorder" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorderHover" Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#565659"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#6A6A6E"/>
    <!-- Accent tints (chip backgrounds behind coloured text) + the accent text on them.
         Amber/Green/Blue text darkens in the light theme for contrast on the pale tints. -->
    <SolidColorBrush x:Key="Amber" Color="#E89B3C"/>
    <SolidColorBrush x:Key="AmberDark" Color="#3B2F1B"/>
    <SolidColorBrush x:Key="Green" Color="#3DD68C"/>
    <SolidColorBrush x:Key="GreenDark" Color="#12351F"/>
    <SolidColorBrush x:Key="Blue" Color="#5AA9F9"/>
    <SolidColorBrush x:Key="BlueDark" Color="#12314F"/>

    <!-- Accents that stay constant across themes (Coral CTA, Toki pink, purple). -->
    <SolidColorBrush x:Key="Coral" Color="#FF6F61"/>
    <SolidColorBrush x:Key="Pink" Color="#F09CC7"/>
    <SolidColorBrush x:Key="Purple" Color="#C08AF0"/>
    <!-- Destructive action (Delete). A clean, professional crimson (Radix red 9) - reads as a
         serious action, not the loud orange-coral it was. Subtle tint behind it. Constant across themes. -->
    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerTint" Color="#1AE5484D"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Windows' crisp monochrome icon font (Win11 Fluent, falls back to Win10 MDL2). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Chip}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- The HIT TARGET is this padded, rounded box - never the glyphs inside it. Bumped from 14,7
             (owner, 2026-08-06: the notch buttons were "impractical", you had to aim at the text).
             MinHeight/MinWidth put a floor under it so even a one-character label ("▾") stays easy to
             hit; the Border always has a Background, which is what makes the whole box hit-testable
             rather than just the letters. -->
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                        <!-- A separate OVERLAY layer carries the hover, because the fill alone can't.
                             Plenty of buttons here are deliberately Background="Transparent" (Later,
                             Cancel, Disconnect, "Library ›"), and dimming the opacity of something
                             transparent is invisible - so those buttons had no hover at all and read as
                             bare text you had to aim at. The overlay draws the rounded box exactly where
                             the button can be clicked. -->
                        <Border x:Name="Hl" CornerRadius="13" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <!-- Centred on the CAP HEIGHT, not on the line box. WPF centres the line box,
                                 which reserves descender space the letters do not use, so a label centred
                                 by layout sits visibly low. OpticalCenter reads the real font metrics and
                                 nudges by the exact amount, scaled to the font size - the previous fixed
                                 fixed 1px nudge was right at one size and wrong everywhere else
                                 (measured: every pill label still sat 1.7px low). The hittest self-test
                                 fails above 1.5px. -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              theme:OpticalCenter.Enabled="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoralButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource Coral}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="WhiteButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource WhiteBtn}"/>
        <Setter Property="Foreground" Value="{DynamicResource CtaText}"/>
    </Style>

    <!-- Filter/toggle chip: an outlined pill (glyph + label) that fills when active. The single
         premium pattern for the composer's duration / Meet / people toggles (no "✓" text hacks). -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="13,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width "row" that is a BUTTON: a settings line with a title, a sub-line and a chevron,
         which opens something. Quiet at rest, a rounded box on hover - the whole row, so the box you
         see is exactly the area you can click. Use this instead of a Border with mouse handlers; a real
         Button gets keyboard/automation for free and can never be mistaken for decoration. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressOverlay}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource AmberDark}"/>
        <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
    </Style>

    <!-- VS Code-style pane splitter: a wide invisible grab strip with a 1px seam line that lights
         up (pink, 2px) on hover/drag. Smooth because only the thin line animates, not a grey bar. -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="9"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndCurrent"/>
        <Setter Property="ResizeDirection" Value="Columns"/>
        <Setter Property="Panel.ZIndex" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <!-- No always-on divider line (the panels' own background difference is the boundary).
                         A subtle grey seam appears only while you hover the grab strip to resize - never a
                         loud coloured line. -->
                    <Border Background="Transparent">
                        <Border x:Name="Seam" Width="1" HorizontalAlignment="Center"
                                Background="Transparent">
                            <Border.RenderTransform><ScaleTransform x:Name="SeamScale" ScaleX="1"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seam" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Seam" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded-square action button (stop) -->
    <Style x:Key="SquareButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Coral}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="9" Width="28" Height="28">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small icon button (gear, back, copy, open, close) - crisp Fluent glyph that
         floats until hovered, then lifts on a subtle rounded highlight (design style). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <!-- 34px, not 30: a bare glyph is a small thing to aim at, and this is the size the hover
             highlight reveals - so what you can hit is exactly what lights up. -->
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent, NOT unset: an unset Background is null, and a null-background Border
                         is invisible to hit testing, which leaves only the glyph itself clickable. -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressOverlay}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Type ramp - a restrained set (premium products use ~6 sizes, not 18). Weight carries
         hierarchy: Regular reads, SemiBold structures. Nothing below 9.5 (illegible = slop). ══ -->

    <!-- Section header / overline ("DECISIONS", "COMING UP", …): small, SemiBold (not heavy Bold), dim. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style x:Key="Micro" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}"/>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Row titles / button labels: same size as Body, SemiBold for structure. -->
    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Page headers, greeting, timer. -->
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The BIG header at the top of a Library page ("Templates", "Settings"). One style, because when
         each page picked its own size and weight they drifted: Templates was 22 Bold and Settings 22
         SemiBold, which reads as a different typeface even though the family is identical.
         SETTINGS is the reference (owner, 2026-08-06) - SemiBold, not Bold. Heavy weights are what made
         the other pages look like a different font in the first place; SemiBold structures without
         shouting, which is the rest of the type ramp's rule too. -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The line under a page header. Based on Body (not Dim) because Dim is declared further down and
         StaticResource only ever looks BACKWARDS through a dictionary - referencing it from here throws
         "Cannot find resource named 'Dim'" at parse time. -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- A section heading WITHIN a page ("Appearance", "AI summaries", a template's name). -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The header of a NOTCH page ("Meetings", "Transcript", "Settings"). Smaller than a window page
         title because the notch is 356px wide, but the same SemiBold weight - one voice, two scales.
         The three notch headers were already identical by hand; this makes them stay that way. -->
    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The title of an open note, in the Library's reading pane. -->
    <Style x:Key="NoteTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Secondary content that must still be read (sub-rows, hints). -->
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="10.5"/>
    </Style>

    <!-- Meta: times, durations, subtitles. -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Dim}"/>

    <!-- ══ Slim, rounded, mac-style scrollbar (applies app-wide) ══ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Toki checkbox: rounded square, GREEN fill + a crisp centered tick when done ══
         Redesigned: 18px box, r5; the tick is a fixed 12px path (NOT stretched - the old uniform
         stretch distorted it and clipped the caps); dark-on-green (Linear/Things look); check pops
         with a gentle spring. Green = done, freeing coral to mean only record/destructive. -->
    <Style x:Key="TokiCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- The tick box READS as 18px but is HIT as 24. A transparent 24x24 pad around it
                         costs nothing visually and lifts the target to the 24px floor a pointer needs -
                         ticking a to-do should not require precision. The pad must be Transparent, not
                         unset: unset is null and a null background is invisible to hit testing, which
                         would leave only the 18px box clickable and make this pointless. -->
                    <Grid Background="Transparent" Width="24" Height="24">
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="{DynamicResource CheckBorder}" BorderThickness="1.5"
                            SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Path x:Name="Tick" Width="12" Height="12" Stretch="None" Opacity="0"
                              Stroke="#101012" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 1.5,6 L 4.6,9 L 10.5,2.6"/>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBorderHover}"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Green}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Green}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Prep-card variant: amber resting outline ("still open" = gentle time-urgency), same geometry. -->
    <Style x:Key="TokiCheckOpen" TargetType="CheckBox" BasedOn="{StaticResource TokiCheck}"/>

    <!-- ══ Toggle switch - for Settings booleans (replaces the bare Win32 checkbox). Track fills
         green + thumb slides on. ══ -->
    <Style x:Key="TokiSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- The track READS as 36x21 but is HIT as 36x26. A switch is a small thing to aim
                         at and the extra height is invisible; the pad must be Transparent (not unset,
                         which is null and not hit-testable) or it adds nothing. -->
                    <Grid Background="Transparent" Height="26">
                    <Border x:Name="Track" Width="36" Height="21" CornerRadius="10.5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Chip}" SnapsToDevicePixels="True">
                        <Border x:Name="Thumb" Width="15" Height="15" CornerRadius="7.5"
                                Background="{DynamicResource WhiteBtn}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Green}"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" From="3,0,0,0" To="18,0,0,0" Duration="0:0:0.14">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
