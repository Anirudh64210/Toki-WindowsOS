<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette sampled from Toki-ProductDesign/ -->
    <SolidColorBrush x:Key="Surface" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Chip" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="TextDim" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="Coral" Color="#F94A26"/>
    <SolidColorBrush x:Key="Amber" Color="#E89B3C"/>
    <SolidColorBrush x:Key="AmberDark" Color="#3B2F1B"/>
    <SolidColorBrush x:Key="Pink" Color="#F09CC7"/>
    <SolidColorBrush x:Key="WhiteBtn" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Ink" Color="#141414"/>
    <SolidColorBrush x:Key="Green" Color="#3DD68C"/>
    <SolidColorBrush x:Key="GreenDark" Color="#12351F"/>
    <SolidColorBrush x:Key="Blue" Color="#5AA9F9"/>
    <SolidColorBrush x:Key="BlueDark" Color="#12314F"/>
    <SolidColorBrush x:Key="Purple" Color="#C08AF0"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Chip}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoralButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource Coral}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="WhiteButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource WhiteBtn}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource AmberDark}"/>
        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
    </Style>

    <!-- Rounded-square action button (stop) -->
    <Style x:Key="SquareButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Coral}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="9" Width="28" Height="28">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon button (gear, back, close) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    </Style>

    <!-- Section header ("DECISIONS", "ACTION ITEMS", …) -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="FontSize" Value="10.5"/>
    </Style>

</ResourceDictionary>
