<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Toki.Theme">

    <!-- ════════════════════════════════════════════════════════════════════════════
         THEMEABLE BRUSHES, with the DARK defaults below. The light/dark toggle
         (ThemeManager.Apply) REPLACES each brush in the application resources with a fresh
         one - it does NOT mutate these in place (see ARCHITECTURE "replace the brush, don't
         mutate it") - so only DynamicResource consumers recolour live; code-built UI that
         captured a brush via FindResource must rebuild on ThemeChanged. ThemeManager.Palette
         is the single source of truth for the dark↔light values; add new colours there as a
         Color+brush pair, not only here.
         ════════════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Surface" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Chip" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="Text" Color="#F5F5F4"/>
    <SolidColorBrush x:Key="TextSoft" Color="#DDDDDB"/>
    <SolidColorBrush x:Key="TextDim" Color="#A8A8AD"/>
    <SolidColorBrush x:Key="Ink" Color="#141414"/>
    <SolidColorBrush x:Key="Notch" Color="#000000"/>
    <SolidColorBrush x:Key="NotchBorder" Color="#33000000"/>
    <SolidColorBrush x:Key="WhiteBtn" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="CtaText" Color="#141414"/>
    <!-- Hover / press wash. 22% white, not 12%: the notch is pitch black, and 12% white over #000 is
         RGB ~31 - about 1.15:1 contrast, which nobody can see. The buttons were highlighting across
         their whole box all along; there was nothing visible to show for it. Keep these in step with
         ThemeManager.Palette, which is the source of truth for the light values. -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="PressOverlay" Color="#57FFFFFF"/>
    <SolidColorBrush x:Key="Hairline" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBorder" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorder" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorderHover" Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#565659"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#6A6A6E"/>
    <!-- Accent tints (chip backgrounds behind coloured text) + the accent text on them.
         Amber/Green/Blue text darkens in the light theme for contrast on the pale tints. -->
    <SolidColorBrush x:Key="Amber" Color="#E89B3C"/>
    <SolidColorBrush x:Key="AmberDark" Color="#3B2F1B"/>
    <SolidColorBrush x:Key="Green" Color="#3DD68C"/>
    <SolidColorBrush x:Key="GreenDark" Color="#12351F"/>
    <SolidColorBrush x:Key="Blue" Color="#5AA9F9"/>
    <SolidColorBrush x:Key="BlueDark" Color="#12314F"/>

    <!-- ── The 2026-08 redesign material (figma "Redesign by SKz", node 288:4) ──
         Warm dark GLASS, not flat black: the card is rgba(33,30,30,0.5) over the desktop with a
         frost, a 10% white rim, radius 24. Text is WHITE AT AN OPACITY (90/50/25), never a grey hex -
         that is what keeps it legible over any glass tint. The opaque values approximate the glass
         reading for when acrylic is off/unavailable. Keep in step with ThemeManager.Palette. -->
    <SolidColorBrush x:Key="Glass" Color="#D9211E1E"/>          <!-- card fill; 85% so contrast never depends on the wallpaper -->
    <SolidColorBrush x:Key="GlassOpaque" Color="#2B2828"/>      <!-- same reading, no acrylic -->
    <SolidColorBrush x:Key="GlassCapsule" Color="#66211E1E"/>   <!-- inner rows/capsules, r12 -->
    <SolidColorBrush x:Key="GlassCapsuleOpaque" Color="#252222"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#1AFFFFFF"/>    <!-- the 1px rim -->
    <!-- Glass ON glass: a control resting on the card is a STEP OF LIGHT above it, never the card's
         own tint again. Hover BRIGHTENS (Control Center lightens under the pointer); press brightens
         further. In the light theme these invert to low-alpha blacks, because more white on a
         near-white capsule is a change nobody can see. Source of truth: ThemeManager.Palette.

         WHICH HOVER BRUSH A CONTROL TAKES (2026-08-18). Every interactive style now fades a sibling
         overlay in and out, but they do not all fade the same brush, and that is deliberate:
           · GlassFillHover/Press - only for a control that is its own FREE-FLOATING GLASS CARD over
             the desktop (GlassPill, RoundPuck). It is a small step because the thing it lights is
             already a plate over a wallpaper that could be any brightness.
           · HoverOverlay/PressOverlay - for every control resting ON a surface (the pills, chips,
             rows, icon buttons, checks, the switch). 22% white is not a taste: it is the measured
             value from the day a 12% wash on the dark notch (1.15:1) was mistaken for a broken
             input layer. Do not quietly lower it to match the glass tokens. -->
    <SolidColorBrush x:Key="GlassFill" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassFillHover" Color="#21FFFFFF"/>
    <SolidColorBrush x:Key="GlassFillPress" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="GlassRim" Color="#17FFFFFF"/>
    <!-- The three rings of a floating capsule's soft shadow (widest and faintest first). Stacked
         translucent shapes rather than a DropShadowEffect: these pills live inside the notch's
         scale-animated content host, and an Effect in an animated subtree renders it in software on
         every frame (motion skill §1.3). -->
    <SolidColorBrush x:Key="Shadow1" Color="#0D000000"/>
    <SolidColorBrush x:Key="Shadow2" Color="#12000000"/>
    <SolidColorBrush x:Key="Shadow3" Color="#18000000"/>
    <SolidColorBrush x:Key="SidebarButton" Color="#3C3837"/>   <!-- a control resting on the sidebar card -->
    <SolidColorBrush x:Key="RowFill" Color="#14FFFFFF"/>        <!-- Library list row, at rest -->
    <SolidColorBrush x:Key="RowFillHover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="MascotBubble" Color="#D9F4F7FB"/>   <!-- the disc Toki floats in -->
    <SolidColorBrush x:Key="MascotBubbleRim" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="TextHi" Color="#E6FFFFFF"/>         <!-- white 90% -->
    <SolidColorBrush x:Key="TextMid" Color="#A6FFFFFF"/>        <!-- white 65% -->
    <SolidColorBrush x:Key="TextLow" Color="#73FFFFFF"/>        <!-- white 45% -->
    <SolidColorBrush x:Key="AccentAmber" Color="#F5A05C"/>      <!-- event accent line / "n open" -->
    <SolidColorBrush x:Key="AccentTeal" Color="#32C7D3"/>       <!-- event accent line / actions -->
    <SolidColorBrush x:Key="JoinPill" Color="#E6FFFFFF"/>       <!-- white pill, black label -->
    <SolidColorBrush x:Key="JoinPillText" Color="#E6000000"/>
    <!-- Stop, and nothing else. Apple's system red, which is the clean red the owner asked for
         (2026-08-19). The token here used to hold Apple's systemPink, which read as magenta beside
         the coral CTA, and nothing consumed it. -->
    <SolidColorBrush x:Key="StopRed" Color="#FF453A"/>

    <!-- Coral CTA, Toki pink, purple. These were documented as "constant across themes" and had no
         light values at all, which meant pastels drawn for a near-black card were being painted onto
         a near-white one: Pink measured 1.66:1 on a light chip. They are theme-swapped now, in
         ThemeManager.Palette - anything painted as TEXT needs both ends of that table. -->
    <SolidColorBrush x:Key="Coral" Color="#FF6F61"/>
    <SolidColorBrush x:Key="Pink" Color="#F09CC7"/>
    <SolidColorBrush x:Key="Purple" Color="#C08AF0"/>
    <!-- Destructive action (Delete). Raised from #E5484D, which measured 3.56:1 as text on the dark
         card - under the 4.5 bar. It is only ever used as a LABEL, never as a fill. -->
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <!-- The label on a Coral fill. Dark theme: coral is a light salmon, so the label is near-black
         (white on it measured 2.73:1). Light theme: coral is a deep red, so the label is white. -->
    <SolidColorBrush x:Key="CoralText" Color="#24100D"/>
    <SolidColorBrush x:Key="DangerTint" Color="#1AE5484D"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Windows' crisp monochrome icon font (Win11 Fluent, falls back to Win10 MDL2). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Keyboard-focus ring (the "missing focus state" the audit flagged). WPF's FocusVisualStyle shows
         only on KEYBOARD focus, not a mouse click, so it gives tab users a visible "you are here" without
         a ring flashing on every click. A rounded blue stroke just outside the control, matching the
         brand-active blue. Applied to the interactive controls users can tab to (toggles, checkboxes,
         text inputs). -->
    <Style x:Key="TokiFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2" Stroke="{DynamicResource Blue}"
                               RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Chip}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- The HIT TARGET is this padded, rounded box - never the glyphs inside it. Bumped from 14,7
             (owner, 2026-08-06: the notch buttons were "impractical", you had to aim at the text).
             MinHeight/MinWidth put a floor under it so even a one-character label ("▾") stays easy to
             hit; the Border always has a Background, which is what makes the whole box hit-testable
             rather than just the letters. -->
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Press = the whole box compresses (scale 0.97 in 90ms), release springs back with
                         a whisper of overshoot - the "haptic feel" of the premium overlay class, applied
                         HERE so every pill in the app presses identically (motion-and-feel skill §3). -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- A separate OVERLAY layer carries the hover, because the fill alone can't.
                                 Plenty of buttons here are deliberately Background="Transparent" (Later,
                                 Cancel, Disconnect, "Library ›"), and dimming the opacity of something
                                 transparent is invisible - so those buttons had no hover at all and read as
                                 bare text you had to aim at. The overlay draws the rounded box exactly where
                                 the button can be clicked.
                                 It is a SIBLING of the content, not its parent, and it FADES (130ms in,
                                 90ms out - motion skill §2/§3: hover is a real fill change, and exits run
                                 at ~70% of enters). As the content's parent it could not fade at all
                                 without taking the label with it, which is why this used to be an instant
                                 swap plus an opacity dim on the whole button - and that dim is what greyed
                                 a translucent fill instead of brightening it. -->
                            <Border x:Name="Hl" CornerRadius="13" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <Border Padding="{TemplateBinding Padding}">
                                <!-- Centred on the CAP HEIGHT, not on the line box. WPF centres the line box,
                                     which reserves descender space the letters do not use, so a label centred
                                     by layout sits visibly low. OpticalCenter reads the real font metrics and
                                     nudges by the exact amount, scaled to the font size - the previous fixed
                                     fixed 1px nudge was right at one size and wrong everywhere else
                                     (measured: every pill label still sat 1.7px low). The hittest self-test
                                     fails above 1.5px. -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  theme:OpticalCenter.Enabled="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <!-- The one place an opacity change survives: a momentary press dip. It is what
                                 gives the opaque CTAs (the white "Open Library", the coral record button) a
                                 press cue that a white wash on a near-white fill cannot. -->
                            <Setter TargetName="Bd" Property="Opacity" Value="0.94"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- DISABLED: a disabled button used to look identical to a live one (the "missing
                             state" the audit flagged). Dim the whole box and drop the hand cursor so it
                             reads as unavailable. Covers WhiteButton/CoralButton (they inherit this). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoralButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource Coral}"/>
        <Setter Property="Foreground" Value="{DynamicResource CoralText}"/>
    </Style>

    <Style x:Key="WhiteButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource WhiteBtn}"/>
        <Setter Property="Foreground" Value="{DynamicResource CtaText}"/>
    </Style>

    <!-- ═══ The compact notch pills (redesign, the six "Menu Bar" frames) ═══
         These states are NOT drawn on the big glass card - each one IS its own free-floating
         capsule over the desktop. So each pill is a MINI CARD and carries the card's whole
         material: the plate gradient (lighter at the top), the gradient rim (brightest at the top),
         and a soft shadow underneath.

         THE SHADOW IS THREE STACKED TRANSLUCENT SHAPES, NOT AN EFFECT (2026-08-18). The comment
         that used to sit here claimed a DropShadowEffect was "safe because these pills do not
         animate their own subtree" - and then no shadow was ever drawn at all, so the claim was
         never tested. It is also wrong twice over: the pill compresses on press (a ScaleTransform),
         and the whole view lives inside the notch's Host, which scale-animates on every state
         morph. An Effect in either subtree renders it in SOFTWARE, every frame (motion skill §1.3).
         Rings instead: widest and faintest at the back, offset downward, opacity rising as they
         tighten (skill §5). They are Rectangles rather than Borders on purpose: the hittest self-test measures
         label centring against the largest BORDER that paints a fill, and a shadow ring is not the
         button's visible box. -->
    <Style x:Key="GlassPill" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextHi}"/>
        <Setter Property="Background" Value="{DynamicResource CardPlate}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle RadiusX="21" RadiusY="21" Margin="-3,2,-3,-4" Fill="{DynamicResource Shadow1}" IsHitTestVisible="False"/>
                        <Rectangle RadiusX="21" RadiusY="21" Margin="-2,2,-2,-3" Fill="{DynamicResource Shadow2}" IsHitTestVisible="False"/>
                        <Rectangle RadiusX="21" RadiusY="21" Margin="-1,2,-1,-2" Fill="{DynamicResource Shadow3}" IsHitTestVisible="False"/>
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="24"
                            BorderBrush="{DynamicResource CardRim}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- Hover is a real fill change that BRIGHTENS, faded in over 130ms - not an
                                 opacity dim, which greys a translucent plate instead of lighting it. -->
                            <Border x:Name="Hl" CornerRadius="23" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource GlassFillHover}"/>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  theme:OpticalCenter.Enabled="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource GlassFillPress}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 24px round control on the recording bar (stop), and the 20px close puck. The whole
         disc is the hit target, not the glyph - a clickable thing is a Button, and the box IS
         the button. Icons compress harder than pills (0.94) per the motion rules. -->
    <Style x:Key="RoundPuck" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource GlassCapsule}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- The same three-ring soft shadow as GlassPill, as ELLIPSES (a Shape, so the
                             hit-target harness never mistakes a shadow for the button's visible box). -->
                        <Ellipse Margin="-2,1,-2,-3" Fill="{DynamicResource Shadow1}" IsHitTestVisible="False"/>
                        <Ellipse Margin="-1,1,-1,-2" Fill="{DynamicResource Shadow2}" IsHitTestVisible="False"/>
                        <Ellipse Margin="0,1,0,-1" Fill="{DynamicResource Shadow3}" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="100"
                                BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Brightens on hover (130ms), brighter still on press - a fill change, never a dim. -->
                        <Border x:Name="Hl" CornerRadius="100" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource GlassFillHover}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource GlassFillPress}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 20px round chip an evidence link's play control sits in, INSIDE a note's document.
         Same grammar as every other glass control (a 1px rim, a hover overlay that FADES in at 130ms
         and out at 90ms, a press that compresses the box) rather than the instant background swap it
         used to do, which was the one control in a note that did not feel like the rest of Toki.
         It is small on purpose: it is an aside beside a sentence, not an action bar. -->
    <!-- The quiet evidence play control: a bare play triangle, no disc and no rim, resting dim and
         brightening on hover. Replaces the old 20px filled chip, which read as a bulky bead in the
         middle of a sentence. -->
    <Style x:Key="EvidencePlay" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.09"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.82" Duration="0:0:0.09"/>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.82" Duration="0:0:0.09"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EvidenceChip" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Chip}"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hl" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource HoverOverlay}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter/toggle chip: an outlined pill (glyph + label) that fills when active. The single
         premium pattern for the composer's duration / Meet / people toggles (no "✓" text hacks). -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="13,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- Hover BRIGHTENS, as a fading sibling of the label (130ms in, 90ms out).
                                 It used to be Opacity 0.82 on the whole button, which fades the LABEL as
                                 well and greys a translucent chip instead of lighting it - and on a chip
                                 whose fill is Transparent by default there was nothing for a dim to act
                                 on at all, so the resting state had no hover to speak of.
                                 The padding moved onto an inner Border so the overlay can cover the whole
                                 box: a highlight inset by the padding is a lie about where the chip is. -->
                            <Border x:Name="Hl" CornerRadius="9" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="{TemplateBinding FontSize}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.97" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width "row" that is a BUTTON: a settings line with a title, a sub-line and a chevron,
         which opens something. Quiet at rest, a rounded box on hover - the whole row, so the box you
         see is exactly the area you can click. Use this instead of a Border with mouse handlers; a real
         Button gets keyboard/automation for free and can never be mistaken for decoration. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- The row's fill is a fading OVERLAY, not a swap of Bd's own Background: an
                                 instant swap pops, and the row's resting fill is Transparent so there was
                                 nothing to transition between. Same grammar as every other control - a
                                 brighten in 130ms, out in 90. -->
                            <Border x:Name="Hl" CornerRadius="12" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- A full-width row compresses LESS than a pill (0.985) - big things are heavy. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.985" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ BareButton: press feedback with NO box ═══
         For the one case where the thing you click IS the artwork - Toki himself. He is a soft
         drawn character with his own silhouette, and putting a grey rounded rectangle behind him
         on hover draws a box around a shape that is deliberately not a box (owner, 2026-08-14, with
         a screenshot: "the toki symbol when you hover over has a button background, that was not
         there before and shouldnt be, its just the mascot").

         It is still a Button, because it still has to press: the alternative is the Border-with-a-
         mouse-handler that this project has shipped five times, which gives no feedback at all. So
         the hover and press FILLS are dropped and only the compress is kept. The affordance is the
         hand cursor plus Toki reacting when you poke him, which is a better one than a grey box. -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Background stays the TemplateBinding (normally Transparent) in every state, so
                         the whole box is hit-testable edge to edge without ever being visible. -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Deeper than a row's 0.985: with no box to squash, the compress has to be
                             visible on the artwork itself to register as a press at all. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.93" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.93" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource AmberDark}"/>
        <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
    </Style>

    <!-- VS Code-style pane splitter: a wide invisible grab strip with a 1px seam line that lights
         up (pink, 2px) on hover/drag. Smooth because only the thin line animates, not a grey bar. -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="9"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndCurrent"/>
        <Setter Property="ResizeDirection" Value="Columns"/>
        <Setter Property="Panel.ZIndex" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <!-- No always-on divider line (the panels' own background difference is the boundary).
                         A subtle grey seam appears only while you hover the grab strip to resize - never a
                         loud coloured line. -->
                    <Border Background="Transparent">
                        <Border x:Name="Seam" Width="1" HorizontalAlignment="Center"
                                Background="Transparent">
                            <Border.RenderTransform><ScaleTransform x:Name="SeamScale" ScaleX="1"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seam" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Seam" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded-square action button (stop) -->
    <Style x:Key="SquareButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Coral}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="9" Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- Its fill is an OPAQUE CTA (coral), so the wave-1 exception applies: the
                                 hover is still the fading brighten overlay, and the only opacity change
                                 left is the momentary press dip - a white wash on a saturated fill is a
                                 weak press cue on its own, and dimming on HOVER makes a live button look
                                 disabled. -->
                            <Border x:Name="Hl" CornerRadius="9" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.94"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small icon button (gear, back, copy, open, close) - crisp Fluent glyph that
         floats until hovered, then lifts on a subtle rounded highlight (design style). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <!-- 34px, not 30: a bare glyph is a small thing to aim at, and this is the size the hover
             highlight reveals - so what you can hit is exactly what lights up. -->
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent, NOT unset: an unset Background is null, and a null-background Border
                         is invisible to hit testing, which leaves only the glyph itself clickable. -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                            <!-- Bd's own Background stays Transparent in every state - it is what makes
                                 the whole 34px box hit-testable - and the highlight is this fading
                                 sibling instead. Swapping Bd's fill meant the box appeared instantly
                                 under the pointer, which is the one thing a glass surface never does. -->
                            <Border x:Name="Hl" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressOverlay}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.94" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Type ramp - a restrained set (premium products use ~6 sizes, not 18). Weight carries
         hierarchy: Regular reads, SemiBold structures. Nothing below 9.5 (illegible = slop). ══ -->

    <!-- Section header / overline ("DECISIONS", "COMING UP", …): small, SemiBold (not heavy Bold), dim. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style x:Key="Micro" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}"/>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Row titles / button labels: same size as Body, SemiBold for structure. -->
    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Page headers, greeting, timer. -->
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The BIG header at the top of a Library page ("Templates", "Settings"). One style, because when
         each page picked its own size and weight they drifted: Templates was 22 Bold and Settings 22
         SemiBold, which reads as a different typeface even though the family is identical.
         SETTINGS is the reference (owner, 2026-08-06) - SemiBold, not Bold. Heavy weights are what made
         the other pages look like a different font in the first place; SemiBold structures without
         shouting, which is the rest of the type ramp's rule too. -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The line under a page header. Based on Body (not Dim) because Dim is declared further down and
         StaticResource only ever looks BACKWARDS through a dictionary - referencing it from here throws
         "Cannot find resource named 'Dim'" at parse time. -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- A section heading WITHIN a page ("Appearance", "AI summaries", a template's name). -->
    <!-- A section heading on a WINDOW page. The gap to whatever it labels lives HERE, not at each
         call site: the captions that used to sit between a title and its card were removed, and
         every title that had leaned on the caption's margin ended up flush against its own card.
         One definition, one edit. -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- The header of a NOTCH page ("Meetings", "Transcript", "Settings"). Smaller than a window page
         title because the notch is 356px wide, but the same SemiBold weight - one voice, two scales.
         The three notch headers were already identical by hand; this makes them stay that way. -->
    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- The title of an open note, in the Library's reading pane. -->
    <Style x:Key="NoteTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Secondary content that must still be read (sub-rows, hints). -->
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="10.5"/>
    </Style>

    <!-- Meta: times, durations, subtitles. -->
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Dim}"/>

    <!-- ══ Slim, rounded, mac-style scrollbar (applies app-wide) ══ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Toki checkbox: rounded square, GREEN fill + a crisp centered tick when done ══
         Redesigned: 18px box, r5; the tick is a fixed 12px path (NOT stretched - the old uniform
         stretch distorted it and clipped the caps); dark-on-green (Linear/Things look); check pops
         with a gentle spring. Green = done, freeing coral to mean only record/destructive. -->
    <Style x:Key="TokiCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- The tick box READS as 18px but is HIT as 24. A transparent 24x24 pad around it
                         costs nothing visually and lifts the target to the 24px floor a pointer needs -
                         ticking a to-do should not require precision. The pad must be Transparent, not
                         unset: unset is null and a null background is invisible to hit testing, which
                         would leave only the 18px box clickable and make this pointless. -->
                    <Grid Background="Transparent" Width="24" Height="24">
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="{DynamicResource CheckBorder}" BorderThickness="1.5"
                            SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Grid>
                            <!-- The wash is a fading sibling UNDER the tick, concentric with the box
                                 (r5 minus its 1.5 rim). As a Background setter on Box it could not fade,
                                 and the checked state's own Background setter won the tie - so hovering a
                                 ticked box gave no feedback at all. -->
                            <Border x:Name="Hl" CornerRadius="3.5" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <Path x:Name="Tick" Width="12" Height="12" Stretch="None" Opacity="0"
                                  Stroke="#101012" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1.5,6 L 4.6,9 L 10.5,2.6"/>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBorderHover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Green}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Green}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Prep-card variant: amber resting outline ("still open" = gentle time-urgency), same geometry. -->
    <Style x:Key="TokiCheckOpen" TargetType="CheckBox" BasedOn="{StaticResource TokiCheck}"/>

    <!-- CIRCULAR check - the redesign's action-item tick (figma 329:1907 / library 348:2933): a hollow
         ring at rest, a filled TEAL disc with a white tick when done. Meeting-note action items only;
         the square TokiCheck stays for the editor and settings. Same 24px hit pad, same pop-on-tick. -->
    <Style x:Key="CircleCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="24" Height="24">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderBrush="{DynamicResource CheckBorder}" BorderThickness="1.5"
                                SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Grid>
                                <!-- Same fading wash as the square check, concentric with the ring
                                     (r9 minus its 1.5 rim). -->
                                <Border x:Name="Hl" CornerRadius="7.5" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource HoverOverlay}"/>
                                <Path x:Name="Tick" Width="12" Height="12" Stretch="None" Opacity="0"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 1.5,6 L 4.6,9 L 10.5,2.6"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBorderHover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentTeal}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTeal}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BoxScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Toggle switch - for Settings booleans (replaces the bare Win32 checkbox). Track fills
         green + thumb slides on. ══ -->
    <Style x:Key="TokiSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Keyboard-operable in the Library Settings (Space toggles) with a focus ring; the notch never
             takes focus (ShowActivated=False) so this only helps the real, focusable window. -->
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TokiFocus}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- The track READS as 36x21 but is HIT as 36x26. A switch is a small thing to aim
                         at and the extra height is invisible; the pad must be Transparent (not unset,
                         which is null and not hit-testable) or it adds nothing. -->
                    <Grid Background="Transparent" Height="26">
                    <Border x:Name="Track" Width="36" Height="21" CornerRadius="10.5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Chip}" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- The switch was the one interactive control in the app with NO hover state:
                                 nothing happened until you clicked it. Same grammar as everything else - a
                                 fading brighten over the track, under the thumb, so the thumb keeps its
                                 own contrast. (r10.5 = the track's own capsule radius; it has no rim to
                                 sit inside.) -->
                            <Border x:Name="Hl" CornerRadius="10.5" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource HoverOverlay}"/>
                            <!-- The travel is a TRANSFORM, never Margin: animating Margin re-runs Measure and
                                 Arrange on the whole switch every frame, on the UI thread. -->
                            <Border x:Name="Thumb" Width="15" Height="15" CornerRadius="7.5"
                                    Background="{DynamicResource WhiteBtn}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Brand BLUE for "on", not Green: green is reserved for decisions in note
                                 content, so a green toggle was a second meaning for the same colour.
                                 Blue = Toki-active chrome (matches the loader), distinct from content. -->
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Blue}"/>
                            <Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="15"/></Setter.Value></Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="15" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="15" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
