<UserControl x:Class="Toki.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="14,12,14,8">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="‹" FontSize="16" Click="OnBack"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Text="Toki 1.0 · one-time · all on this PC" Style="{StaticResource Dim}" FontSize="9.5"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingTitle}" Text="AI summaries"/>
                <TextBlock Style="{StaticResource Dim}"
                           Text="On-device is free forever &amp; private. Add your own key for sharper summaries — you pay the model, not us."/>
                <Border Background="{StaticResource SurfaceHi}" CornerRadius="10" Padding="3" Margin="0,7,0,0">
                    <UniformGrid x:Name="NotesModeSeg" Columns="3"/>
                </Border>

                <!-- On-device options -->
                <StackPanel x:Name="LocalOptions">
                    <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                        <CheckBox x:Name="GpuToggle" VerticalAlignment="Center" Click="OnGpuToggle"/>
                        <TextBlock Text="Use graphics card when it helps (automatic, faster)" Style="{StaticResource Body}"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" FontSize="9.5" Margin="2,3,0,0"
                               Text="Off = runs on the processor (safe on any machine, a bit slower)."/>
                </StackPanel>

                <!-- BYO API key -->
                <StackPanel x:Name="ApiOptions" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingTitle}" Text="API key" FontSize="11.5"/>
                    <Border Background="{StaticResource SurfaceHi}" CornerRadius="8" Padding="10,0" Margin="0,4,0,0">
                        <PasswordBox x:Name="ApiKeyBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" Height="32" FontSize="11.5"
                                     FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                     PasswordChanged="OnApiKeyChanged"/>
                    </Border>
                    <TextBlock Style="{StaticResource Dim}" FontSize="9.5" Margin="2,3,0,0"
                               Text="Stored encrypted on this PC (DPAPI). OpenAI-compatible endpoints."/>
                </StackPanel>

                <TextBlock Style="{StaticResource SettingTitle}" Text="Model status"/>
                <TextBlock x:Name="ModelStatus" Style="{StaticResource Dim}" FontSize="10.5"/>

                <TextBlock Style="{StaticResource Dim}" FontSize="9" Margin="2,16,0,6" TextAlignment="Center"
                           Text="Auto-record, keep-audio, and the Built-with credits arrive in a later update."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
