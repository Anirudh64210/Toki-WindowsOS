<UserControl x:Class="Toki.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegHost" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style x:Key="SegOn" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Chip}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="SegOff" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
        <Style x:Key="SegOnText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SegOffText" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="14,12,14,8">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="‹" FontSize="16" Click="OnBack"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Text="Toki 1.0 · one-time" Style="{StaticResource Dim}" FontSize="9.5"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingTitle}" Text="Auto-record meetings"/>
                <TextBlock Style="{StaticResource Dim}" Text="What Toki does when a call is detected."/>
                <Border Style="{StaticResource SegHost}">
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource SegOff}"><TextBlock Text="Always" Style="{StaticResource SegOffText}"/></Border>
                        <Border Style="{StaticResource SegOn}"><TextBlock Text="Ask" Style="{StaticResource SegOnText}"/></Border>
                        <Border Style="{StaticResource SegOff}"><TextBlock Text="Never" Style="{StaticResource SegOffText}"/></Border>
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource SettingTitle}" Text="Keep audio"/>
                <TextBlock Style="{StaticResource Dim}" Text="Transcripts stay forever. Audio is heavier — your call."/>
                <Border Style="{StaticResource SegHost}">
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource SegOn}"><TextBlock Text="Delete after transcript" Style="{StaticResource SegOnText}" FontSize="10"/></Border>
                        <Border Style="{StaticResource SegOff}"><TextBlock Text="Keep 7 days" Style="{StaticResource SegOffText}"/></Border>
                        <Border Style="{StaticResource SegOff}"><TextBlock Text="Keep" Style="{StaticResource SegOffText}"/></Border>
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource SettingTitle}" Text="AI summaries"/>
                <TextBlock Style="{StaticResource Dim}"
                           Text="On-device is free forever &amp; private. Add your own key for sharper summaries — you pay the model, not us."/>
                <Border Style="{StaticResource SegHost}">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SegOn}"><TextBlock Text="On-device (free)" Style="{StaticResource SegOnText}"/></Border>
                        <Border Style="{StaticResource SegOff}"><TextBlock Text="Use my API key" Style="{StaticResource SegOffText}"/></Border>
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource Dim}" FontSize="9" Margin="2,14,0,6" TextAlignment="Center"
                           Text="Hotkey: Ctrl+Alt+Space · these controls are placeholders and get wired up in later milestones."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
