<UserControl x:Class="Toki.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <UserControl.Resources>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
    </UserControl.Resources>
    <!-- The notch Settings is UI/visibility ONLY (owner: "the notch should only have the visibility,
         UI settings"). Everything else - AI summaries, calendar, name, about - lives on the Library's
         Settings page; the row at the bottom takes you there. -->
    <DockPanel Margin="4,12,4,12">
        <Grid DockPanel.Dock="Top" Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnBack"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="Toki 1.0" Style="{StaticResource Dim}" FontSize="12"/>
            </StackPanel>
            <!-- Global toggles, shown ONCE in the header: screen-recording visibility (ghost) + light/dark. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RecordToggle" Style="{StaticResource IconButton}" Click="OnRecordingToggle"/>
                <Button x:Name="ThemeToggle" Style="{StaticResource IconButton}" Click="OnThemeToggle"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" controls:SmoothScroll.Enabled="True" Padding="0">
            <StackPanel>
                <!-- No "Appearance" heading: there is one setting on this page and a link to the rest,
                     so a category label above a single row is a word that earns nothing (owner,
                     2026-08-14: "remove appearance in the notch setting, its self explanatory").

                     The 12px inset is not decoration - it MATCHES RowButton's padding, which is what
                     the button below uses. Without it this row's text started 12px to the left of the
                     button's and the two read as belonging to different pages (owner: "the glassy
                     notch and the all other settings button differ in their starting point ...
                     alignment and symmetry is missing").

                     ONE GUTTER (2026-08-23, mechanism REPLACED 2026-09-03): every piece of TEXT on
                     this page starts at the same x, and it still does. What changed is HOW.
                     Previously the page padded 16, both rows sat at 0 inside it, and the row button
                     dropped its horizontal padding to 0 to reach the gutter. That aligned the text
                     and cost the hover its breathing room: the highlight began exactly where the
                     label did, which the owner reported from a screenshot - "too close to the text,
                     it needs to be overlapping with the actual field".
                     Now the PAGE pads 4 and every row carries the remaining 12 itself: the header
                     and the toggle row as a margin, the button as padding. Text still lands on 16
                     everywhere, and the button box is 12px wider than its label on each side, so the
                     fill reads as a row rather than as a box drawn round the words.
                     Bleeding the box outward with a negative margin was tried twice and the
                     hit-target harness failed it both times: the scroll area clips what hangs past
                     its content, so the row goes dead at both edges. Do not try it a third time.

                     No caption under either title: a settings page that explains each of its own
                     rows reads as generated copy, not as a product (owner, 2026-08-20). A row whose
                     label does not carry it should be renamed, not annotated. -->
                <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Glassy notch" Style="{StaticResource BodyStrong}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="GlassToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}" Click="OnGlassToggle"/>
                </Grid>

                <!-- Everything else → the Library's Settings page. -->
                <!-- NO RULE HERE. It sat directly above a RowButton that paints a hover fill over
                     the full row, so the rule was a fixed line hugging a moving highlight - and a
                     divider between two rows 20px apart is the exact case Material 3 says to solve
                     with white space. Owner, 2026-09-27: the separating lines "is ugly and weird". -->
                <Border Height="8"/>
                <!-- ONE rounded button, not a row with an arrow beside it. It used to hang past both
                     edges on negative margins, so its hover box read as a full-width rectangle rather
                     than a button, and the chevron on the right looked like the thing you were meant to
                     click (owner, 2026-08-06). Now: a real Button, a proper rounded box that sits INSIDE
                     the card, and the chevron is decoration inside it - not hit-testable, so it can
                     never look like a separate control. -->
                <!-- The hover fill has to cover the FIELD, not hug the words. With Padding="0,10" the
                     label sat hard against the button's own edge, so the highlight appeared to start
                     exactly where the text did (owner, 2026-09-03, screenshot). The row now bleeds 12px
                     past the content column on each side and pays that back as padding, so the label
                     stays aligned with "Glassy notch" above it while the highlight reads as a row.
                     This is NOT the 2026-08-06 regression the comment above warns about: that one hung
                     past the CARD's edges and lost its rounded box; this stops at the card's inner pad
                     and keeps radius 12. -->
                <!-- A VISIBLE BUTTON AT REST, matching the Library button on Home (owner, 2026-09-27:
                     "all other settings in the notch needs to have a hovered button look like library
                     button does"). It was a bare label and a chevron on the plate: the hover fill
                     existed and worked, but a control whose only affordance appears once you are
                     already pointing at it is a control you have to discover by accident.
                     ChipOnCard, not Chip: Chip is tuned against the Library window's Surface, which
                     is far darker than the notch plate, and on the card it lands within a couple of
                     points of its own background - the exact bug the owner found on NoSpeech, where
                     "Okay" looked like a line of text. RowButton's hover overlay still fades in on
                     top of this, so the row now has a resting state AND a hover state. -->
                <Button Style="{StaticResource RowButton}" Click="OnOpenLibrarySettings" Padding="12,10"
                        Background="{DynamicResource ChipOnCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="All other settings" Style="{StaticResource BodyStrong}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="12" Foreground="{DynamicResource TextDim}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
