<UserControl x:Class="Toki.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <DockPanel Margin="14,12,14,8">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnBack"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Meetings" Style="{StaticResource PanelTitle}"/>
                <TextBlock x:Name="CountLabel" Text="" Style="{StaticResource Dim}" FontSize="9.5"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,11,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceHi}" CornerRadius="10" Padding="11,0">
                <Grid>
                    <!-- A SEARCH FIELD HAS TO SAY IT IS ONE. Empty, this was a bare rectangle with
                         nothing in it - on the dark card a black void beside the New note button.
                         The tip line underneath explains the you:/them: syntax, but only to someone
                         who already knows the box is for searching. Behind the TextBox, hidden the
                         moment anything is typed. -->
                    <TextBlock x:Name="SearchHint" Text="Search your meetings" FontSize="12"
                               FontFamily="{StaticResource UiFont}" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                             VerticalContentAlignment="Center" Height="34" FontSize="12"
                             FontFamily="{StaticResource UiFont}" TextChanged="OnSearchChanged"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource WhiteButton}" Margin="8,0,0,0" Padding="12,7"
                    Content="+ New note" Click="OnNewNote"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" FontSize="9" Margin="2,6,0,0"
                   Text="Tip:  you: pricing  finds only what you said  ·  them: webhook  finds only them"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" controls:SmoothScroll.Enabled="True">
            <StackPanel x:Name="Cards"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
