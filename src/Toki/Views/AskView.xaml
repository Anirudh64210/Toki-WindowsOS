<UserControl x:Class="Toki.Views.AskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- Minimal, no title bar: the mascot IS the identity; answers are plain text on the surface (no
         chat-app bubbles). Content-sized - it never opens big. -->
    <DockPanel Margin="16,12,16,11" LastChildFill="True">
        <!-- Top: mascot (identity + live state) left; a tiny status word; a ghost close, right. -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- HIDDEN, not removed: the ONE visible Toki on a panel is the floating bubble beside
                 the card (owner: never two mascots on one surface). The blob stays for the code
                 that pokes it; hidden blobs pause their own animation. -->
            <Viewbox Width="26" Height="24" VerticalAlignment="Top" Visibility="Collapsed">
                <controls:TokiBlob x:Name="Toki"/>
            </Viewbox>
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="" Style="{StaticResource Dim}" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE711;"
                    FontSize="11" Opacity="0.45" VerticalAlignment="Top" ToolTip="Close" Click="OnClose"/>
        </Grid>

        <!-- Live state strip (listening waveform / thinking loader / hint) - sits just under the mascot. -->
        <StackPanel x:Name="StatusStrip" DockPanel.Dock="Top" Margin="0,8,0,0">
            <Border x:Name="WaveHost" Height="24" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <Border x:Name="LoaderHost" Visibility="Collapsed" HorizontalAlignment="Left" Margin="1,0,0,0"/>
            <TextBlock x:Name="HintText" Text="Hold Ctrl + Alt + Space and speak" Style="{StaticResource Dim}"
                       FontSize="9.5" Margin="1,6,0,0"/>
        </StackPanel>

        <!-- The conversation thread: plain text turns, grows to content, scrolls past a cap. A floating
             "↓ Latest" pill appears when you scroll UP away from the newest message (esp. mid-stream). -->
        <Grid Margin="0,8,0,0">
            <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" MaxHeight="360"
                          controls:SmoothScroll.Enabled="True">
                <StackPanel x:Name="Thread"/>
            </ScrollViewer>
            <Border x:Name="JumpPill" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                    Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                    CornerRadius="13" Padding="11,5" Cursor="Hand" MouseLeftButtonUp="OnJumpToLatest">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                               Foreground="{DynamicResource Pink}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Latest" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
