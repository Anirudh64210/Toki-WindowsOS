<UserControl x:Class="Toki.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <DockPanel Margin="14,12,14,10">
        <!-- Header: the ONLY arrow (back) · title + scroll-synced subtitle · Today (appears when scrolled
             away) · ＋ New. Week paging is gone - the agenda is one continuous scroll (the cache already
             holds ~31 days), which removed the two week arrows and two rebuild triggers. -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnBack"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Calendar" Style="{StaticResource Title}"/>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Text="This week"/>
            </StackPanel>
            <Button x:Name="TodayButton" Grid.Column="2" Style="{StaticResource PillButton}" Background="Transparent"
                    Foreground="{DynamicResource TextDim}" FontSize="10.5" Padding="10,5" Content="Today"
                    Opacity="0" Visibility="Collapsed" Margin="0,0,6,0" Click="OnToday"/>
            <Button x:Name="NewButton" Grid.Column="3" Style="{StaticResource PillButton}" FontSize="11.5"
                    Padding="12,7" Content="＋ New" Click="OnNew"/>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Hairline}" Margin="0,10,0,0"/>

        <!-- Quick-create composer (natural language). A flat SECTION under the header (a top hairline,
             no enclosing card), so it reads like Fantastical/Cron's NL bar, not a nested widget. -->
        <Border x:Name="Composer" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,12,0,0"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,12,0,2">
            <StackPanel>
                <!-- Shaped like the composer in Google Calendar or Outlook, for the reasons in
                     CalendarView.xaml.cs "the composer":
                       · the title is the first thing and needs no label - a placeholder says what it is
                       · Day and Time still accept typing ("tomorrow", "2pm"), but each now carries a
                         picker, so nobody has to GUESS what this box will accept
                       · both are prefilled with a sensible answer, so the form is never blank
                       · guests are a labelled field that is always there, not a surprise behind a toggle
                       · the Meet link is a labelled switch, because a bare chip cannot say whether it
                         is describing a state or offering an action -->
                <Border Background="{DynamicResource Chip}" CornerRadius="10" Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="TitlePlaceholder" Text="Add a title" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextDim}" Opacity="0.6" VerticalAlignment="Center"
                                   FontSize="13.5" FontFamily="{StaticResource UiFont}" Margin="1,0,0,0"/>
                        <TextBox x:Name="TitleBox" Background="Transparent" BorderThickness="0" Height="38"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 FontSize="13.5" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                 TextChanged="OnComposerField" PreviewKeyDown="OnComposerKey"/>
                    </Grid>
                </Border>

                <!-- WHEN, on two lines - the day, then start–end. Three fields on one 360px line
                     clipped the word "tomorrow" mid-word; Outlook's compact pane stacks them for the
                     same reason. The dash between start and end says they are two ends of one thing. -->
                <TextBlock Text="When" Style="{StaticResource Caption}" Margin="2,12,0,4"/>
                <Border Background="{DynamicResource Chip}" CornerRadius="10" Padding="12,0,4,0">
                    <DockPanel>
                        <Button x:Name="DatePick" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                Content="&#x25BE;" FontFamily="{StaticResource UiFont}" FontSize="10" Width="28" Height="30"
                                ToolTip="Pick a day" Click="OnPickDay"/>
                        <TextBox x:Name="DateBox" Background="Transparent" BorderThickness="0" Height="36"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 FontSize="12.5" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                 TextChanged="OnComposerField" PreviewKeyDown="OnComposerKey"/>
                    </DockPanel>
                </Border>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Chip}" CornerRadius="10" Padding="12,0,4,0">
                        <DockPanel>
                            <Button x:Name="TimePick" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Content="&#x25BE;" FontFamily="{StaticResource UiFont}" FontSize="10" Width="28" Height="30"
                                    ToolTip="Pick a start time" Click="OnPickTime"/>
                            <TextBox x:Name="TimeBox" Background="Transparent" BorderThickness="0" Height="36"
                                     Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                     FontSize="12.5" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                     TextChanged="OnComposerField" PreviewKeyDown="OnComposerKey"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="–" Style="{StaticResource Dim}" FontSize="13"
                               VerticalAlignment="Center" Margin="8,0"/>

                    <Button x:Name="DurationChip" Grid.Column="2" Style="{StaticResource ChipButton}"
                            Content="30 min  &#x25BE;" Click="OnPickDuration" Height="36"
                            HorizontalContentAlignment="Center"
                            ToolTip="When the meeting ends"/>
                </Grid>

                <TextBlock x:Name="ComposerHint" Style="{StaticResource Caption}" Margin="2,7,0,0"
                           Text="Type a day and time, or pick them"/>
                <TextBlock x:Name="ParsePreview" Style="{StaticResource Secondary}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Green}" Margin="2,6,0,0" Visibility="Collapsed"/>

                <TextBlock Text="Guests" Style="{StaticResource Caption}" Margin="2,12,0,4"/>
                <Border x:Name="PeopleRow" Background="{DynamicResource Chip}" CornerRadius="10" Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="PeoplePlaceholder" Text="name@company.com, someone@else.com"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextDim}" Opacity="0.55"
                                   VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource UiFont}"
                                   Margin="1,0,0,0"/>
                        <TextBox x:Name="PeopleBox" Background="Transparent" BorderThickness="0" Height="36"
                                 Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                 FontSize="12" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                                 TextChanged="OnPeopleChanged"/>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Add a Google Meet link" Style="{StaticResource Body}" FontSize="12.5"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="MeetToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}"
                              VerticalAlignment="Center" Click="OnToggleMeet"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="ComposerCancel" Style="{StaticResource PillButton}" Background="Transparent"
                            Foreground="{DynamicResource TextDim}" FontSize="11.5" Padding="12,6" Content="Cancel"
                            Click="OnComposerCancel"/>
                    <Button x:Name="ComposerCreate" Style="{StaticResource WhiteButton}" FontSize="11.5" Padding="18,6"
                            Margin="8,0,0,0" Content="Create" Click="OnComposerCreate"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content area: the day list, plus overlay state panels + the undo/confirm bar -->
        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          controls:SmoothScroll.Enabled="True" Margin="0,8,0,0" ScrollChanged="OnScroll">
                <StackPanel x:Name="Days"/>
            </ScrollViewer>

            <!-- Empty / loading / error / disconnected - one panel, populated in code -->
            <StackPanel x:Name="StatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Margin="20,0"/>

            <!-- Undo / confirm bar, pinned to the bottom -->
            <Border x:Name="ActionBar" VerticalAlignment="Bottom" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceHi}" BorderBrush="{DynamicResource Hairline}"
                    BorderThickness="1" CornerRadius="11" Padding="12,8" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActionText" Style="{StaticResource Body}" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ActionSecondary" Grid.Column="1" Style="{StaticResource PillButton}"
                            Background="Transparent" FontSize="11" Padding="8,4" Margin="8,0,0,0"/>
                    <Button x:Name="ActionPrimary" Grid.Column="2" Style="{StaticResource PillButton}"
                            FontSize="11" Padding="10,4" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
