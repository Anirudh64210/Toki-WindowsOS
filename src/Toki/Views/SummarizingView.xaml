<UserControl x:Class="Toki.Views.SummarizingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <Grid Margin="16,14">
        <!-- Status line, top-center -->
        <StackPanel x:Name="Status" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
            <TextBlock x:Name="Sparkle" Text="✦" Foreground="{StaticResource Amber}" FontSize="15"
                       Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="SparkleSpin"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="StatusText" Text="Finding action items" Style="{StaticResource Body}"
                       FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="Dots" Text="" Style="{StaticResource Body}" FontSize="14"
                       FontWeight="SemiBold" Width="18"/>
        </StackPanel>

        <!-- Scene: a stack of pages, and Toki working -->
        <Grid VerticalAlignment="Bottom" Height="82" Margin="0,0,0,2">
            <!-- Paper stack (left); the top sheet lifts and settles as pages are processed -->
            <Canvas Width="72" Height="64" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,2">
                <Border Canvas.Left="6" Canvas.Top="22" Width="58" Height="40" Background="#D8DAE0" CornerRadius="4" Opacity="0.5"/>
                <Border Canvas.Left="3" Canvas.Top="13" Width="58" Height="40" Background="#E6E8EE" CornerRadius="4" Opacity="0.8"/>
                <Border x:Name="TopPage" Canvas.Left="0" Canvas.Top="4" Width="58" Height="40" Background="#F4F5F8" CornerRadius="4"
                        RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TopPageLift"/>
                    </Border.RenderTransform>
                    <StackPanel Margin="8,7,8,0">
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#B9BCC6" Margin="0,0,0,4"/>
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#C9CCD4" Width="34" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#C9CCD4" Width="42" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- Toki (right), with a soft pulsing glow, bobbing as it works -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,2" Width="72" Height="72">
                <Ellipse x:Name="Glow" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66F48AAE" Offset="0"/>
                            <GradientStop Color="#00F48AAE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="GlowScale" CenterX="36" CenterY="36"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <controls:TokiBlob x:Name="Toki" Width="52" Height="46"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
