<UserControl x:Class="Toki.Views.SummarizingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- "Menu Bar - Processing Notes": a 220x50 glass pill reading "Tidying up your notes...", with
         Toki beside it carrying a little note card (his Thinking mood, set by PillWindow).

         It still lives mostly as a 13px SLIVER - the loader tucks itself away the moment it appears
         so it never sits on your screen while it works. Row 0 IS the sliver, carrying the coral
         shimmer that is its heartbeat; row 1 is the pill you get when you hover it open. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0 is EXACTLY the sliver height (13px): when tucked, only this row shows, so the
                 sliver is a clean dark tab carrying just the shimmer - never a clipped slice of Toki. -->
            <RowDefinition Height="13"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The sliver's heartbeat: a soft coral highlight glides through a thin dim track, on loop.
             This is the ONLY thing visible when the loader is tucked away. -->
        <!-- Track and highlight are THEMED tokens (2026-08-18). Both were hardcoded - a white-8%
             track and a pink gradient built inline - so in the light theme the track was white on
             white and the shimmer ran through nothing anyone could see. -->
        <Border Grid.Row="0" Height="3" VerticalAlignment="Center" Margin="16,0" CornerRadius="1.5"
                Background="{DynamicResource ShimmerTrack}" ClipToBounds="True">
            <Border x:Name="Shimmer" Width="70" HorizontalAlignment="Left" CornerRadius="1.5"
                    Background="{DynamicResource Shimmer}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><TranslateTransform x:Name="ShimmerMove"/></Border.RenderTransform>
            </Border>
        </Border>

        <!-- Expanded content (revealed only when you hover the working sliver fully open). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- HIDDEN: the floating bubble Toki (Thinking mood) is this state's mascot. -->
            <controls:TokiBlob x:Name="Toki" Width="26" Height="24" Margin="0,0,10,0" Visibility="Collapsed"
                               VerticalAlignment="Center" RenderTransformOrigin="0.5,1"/>
            <!-- 13 SemiBold at white 90% - the frame's label size for every one of these pills. -->
            <TextBlock Text="Tidying up your notes" FontFamily="{StaticResource UiFont}"
                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextHi}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="Dots" Text="" FontFamily="{StaticResource UiFont}" FontSize="13"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextHi}"
                       Width="16" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
