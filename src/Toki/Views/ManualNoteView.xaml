<UserControl x:Class="Toki.Views.ManualNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16,12,16,12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnBack"/>
            <TextBlock Grid.Column="1" Text="Note" Style="{StaticResource Dim}" FontSize="10"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnClose"/>
        </Grid>

        <TextBox x:Name="TitleBox" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                 FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                 Margin="0,10,0,0" TextChanged="OnChanged"/>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource SurfaceHi}" Margin="0,8,0,0"/>

        <TextBox x:Name="BodyBox" Background="Transparent" BorderThickness="0"
                 Foreground="#D5D5D3" CaretBrush="{StaticResource Text}"
                 FontSize="12.5" FontFamily="{StaticResource UiFont}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" TextChanged="OnChanged"/>
    </DockPanel>
</UserControl>
