<UserControl x:Class="Toki.Views.RecordingBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calm, minimal recording presence: a slowly-breathing dot + elapsed time +
         a small stop. No looping "waveform" — that was fake decoration and read as
         a distraction sitting on screen the whole meeting. Click the chip to expand. -->
    <Grid Margin="15,0,9,0" Background="Transparent" MouseLeftButtonUp="OnExpand" Cursor="Hand"
          ToolTip="Recording — click to expand">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0"
                 Fill="{StaticResource Coral}" VerticalAlignment="Center"/>
        <TextBlock x:Name="Timer" Grid.Column="1" Text="0:00" Style="{StaticResource Body}"
                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Style="{StaticResource SquareButton}" Margin="12,0,0,0"
                Click="OnStop" ToolTip="Stop &amp; summarize">
            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="White"/>
        </Button>
    </Grid>
</UserControl>
