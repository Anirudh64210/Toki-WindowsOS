<UserControl x:Class="Toki.Views.RecordingBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- Recording: Toki flips and falls to hang UPSIDE-DOWN from the top edge, eyes peeking,
         blinking - alive, minimal, out of the way of browser tabs. Idle shows nothing, so a
         peeking upside-down Toki simply means "I'm recording". Hover for the timer + Stop. -->
    <Grid Background="Transparent" MouseLeftButtonUp="OnExpand" Cursor="Hand"
          ToolTip="Recording - hover for the timer &amp; stop" ClipToBounds="True">
        <Viewbox x:Name="TokiBox" Width="30" VerticalAlignment="Top" HorizontalAlignment="Center"
                 Margin="0,-13,0,0" RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="Flip"/>
                    <TranslateTransform x:Name="Fall"/>
                </TransformGroup>
            </Viewbox.RenderTransform>
            <controls:TokiBlob x:Name="BarToki"/>
        </Viewbox>
    </Grid>
</UserControl>
