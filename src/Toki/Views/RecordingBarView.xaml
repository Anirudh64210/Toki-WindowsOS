<UserControl x:Class="Toki.Views.RecordingBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- While recording, Toki gets out of the way: no timer, no button sitting on
         screen — just the alive character (breathing/blinking) with a small pulsing
         coral dot to say "still recording". Click it to reveal the timer + stop.
         WisprFlow-style: present and calm, never a distraction on the user's work. -->
    <Grid Background="Transparent" MouseLeftButtonUp="OnExpand" Cursor="Hand"
          ToolTip="Recording — click for the timer &amp; stop">
        <Viewbox Width="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:TokiBlob/>
        </Viewbox>
        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Coral}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,7,0"/>
    </Grid>
</UserControl>
