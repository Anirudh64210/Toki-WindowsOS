<UserControl x:Class="Toki.Views.RecordingBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <Grid Margin="16,0,10,0" Background="Transparent" MouseLeftButtonUp="OnExpand" Cursor="Hand">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Timer" Text="0:00" Style="{StaticResource Body}"
                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <controls:Waveform Grid.Column="1" HorizontalAlignment="Center" Margin="10,0"/>
        <Button Grid.Column="2" Style="{StaticResource SquareButton}"
                Click="OnStop" ToolTip="Stop &amp; summarize">
            <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="White"/>
        </Button>
    </Grid>
</UserControl>
