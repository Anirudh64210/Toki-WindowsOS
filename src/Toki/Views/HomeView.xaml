<UserControl x:Class="Toki.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- A vertical stack with uniform gaps. Auto-height sizes the notch to this exactly.
         Two-up Meeting/Take Notes row; then either the connected "COMING UP" list + account
         footer, or the "Connect Google" call-to-action. -->
    <StackPanel Margin="14,13,14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="30" RenderTransformOrigin="0.5,0.9">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="TokiPop"/>
                </Viewbox.RenderTransform>
                <controls:TokiBlob x:Name="TokiChar"/>
            </Viewbox>
            <TextBlock x:Name="Greeting" Grid.Column="1" Text="Welcome back!" Style="{StaticResource Body}"
                       FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                    ToolTip="Settings" Click="OnSettings"/>
        </Grid>

        <!-- Two-up: Meeting (opens the calendar) + Take Notes -->
        <Grid Margin="0,11,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Padding="0,10" HorizontalContentAlignment="Center"
                    Click="OnMeeting" ToolTip="See your week and create a meeting">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Padding="0,10" HorizontalContentAlignment="Center"
                    Click="OnTakeNotes" ToolTip="Start recording this meeting and take notes">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource Coral}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Take Notes" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Connected: upcoming meetings + account footer -->
        <StackPanel x:Name="ConnectedHost" Visibility="Collapsed">
            <TextBlock Text="COMING UP" Style="{StaticResource SectionHeader}" Foreground="{DynamicResource TextDim}"/>
            <StackPanel x:Name="ComingUp"/>
            <Border Margin="0,8,0,0" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Width="Auto" Height="Auto"
                            Padding="2" Click="OnAccount" ToolTip="Manage Google in Settings">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AccountEmail" Margin="6,0,0,0" Style="{StaticResource Dim}" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- A real pill, not bare text: it's a button, so it looks like every other button
                         (owner, 2026-08-06). Transparent + 6,4 padding made it a word you had to hit. -->
                    <Button Grid.Column="1" Style="{StaticResource PillButton}"
                            Foreground="{DynamicResource TextDim}" FontSize="10.5" Padding="12,6"
                            Content="Library  ›" Click="OnLibrary"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Not connected: connect CTA + Library link -->
        <StackPanel x:Name="ConnectHost">
            <Button x:Name="GoogleButton" Margin="0,11,0,0" Style="{StaticResource WhiteButton}" Padding="0,10"
                    HorizontalContentAlignment="Center" Click="OnGoogleConnect"
                    ToolTip="Connect your Google Calendar (sign in in your browser)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="G" FontWeight="Bold" Foreground="#4285F4" Margin="0,0,8,0"/>
                    <TextBlock x:Name="GoogleLabel" Text="Connect Google"/>
                </StackPanel>
            </Button>
            <Button Margin="0,11,0,0" Style="{StaticResource PillButton}"
                    Padding="14,6" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"
                    FontSize="10.5" Content="Library  ›" Click="OnLibrary"/>
        </StackPanel>
    </StackPanel>
</UserControl>
