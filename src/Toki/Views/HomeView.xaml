<UserControl x:Class="Toki.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- The DEFAULT card of the 2026-08 redesign (figma 293:1830), on the glass notch:
           · greeting row - mascot, "Welcome back" 14 over TextHi, calendar + settings icons right
           · COMING UP - 10 Bold header at 50%, event rows as inner capsules (built in code)
           · two equal glass action buttons: "Start a meeting" + "Take Notes"
         The card's own padding is 17 (the frame's p-17); the window supplies the glass. -->
    <StackPanel Margin="17,14,17,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- No mascot HERE: in the redesign Toki floats BESIDE the notch card, in his own bubble
                 (PillWindow.MascotZone) - having one in the greeting row too put him on screen twice
                 (owner report, 2026-08-13). A hidden host keeps the pop/blink wiring alive without
                 drawing anything. -->
            <Viewbox Width="0" Height="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.9">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="TokiPop"/>
                </Viewbox.RenderTransform>
                <controls:TokiBlob x:Name="TokiChar"/>
            </Viewbox>
            <TextBlock x:Name="Greeting" Grid.Column="1" Text="Welcome back"
                       FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="Medium"
                       Foreground="{DynamicResource TextHi}" Margin="1,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Only Settings up here. The Library is a real, labelled button in the bottom
                     right (owner: "library button should be at the bottom right corner, like last
                     time"), and a bare icon was not enough - "the library should have a proper
                     button mentioning library and the symbol, not just the symbol". -->
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13"
                        Foreground="{DynamicResource TextMid}" Margin="2,0,0,0"
                        ToolTip="Settings" Click="OnSettings"/>
            </StackPanel>
        </Grid>

        <!-- The two equal actions from the frame ("Menu Bar - Idle" draws them standalone at 144x40
             with a 12px gap): glass capsule, radius 24, a 16px lucide icon, an 8px gap, and a 13
             SemiBold label at white 90%. Built in code so both pills come from the one PillParts
             definition the compact states use - the same pill everywhere it appears. -->
        <Grid x:Name="ActionRow" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="StartMeetingHost"/>
            <ContentControl x:Name="TakeNotesHost" Grid.Column="2"/>
        </Grid>

        <!-- ══ UPCOMING ══ under the two actions, which is the order the owner asked for: the
             verbs first, then what is coming.

             What used to be here instead: a "Connect a calendar" button with a dropdown caret, a
             row of provider marks, a "+ Google" pill and a "Library >" pill. The owner's verdict
             was "so ugly and weird, what is +google, we have outlook as well, why is that even
             there?" - and they were right on the substance too: naming ONE provider on the home
             screen of an app that supports two is a bug, not a shortcut. Connecting a calendar is
             a once-ever errand and it belongs in Settings, where both providers already live. -->
        <StackPanel x:Name="ConnectedHost" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock Text="UPCOMING" FontFamily="{StaticResource UiFont}" FontSize="10"
                       FontWeight="Bold" Foreground="{DynamicResource TextMid}"
                       Margin="1,0,0,8"/>
            <StackPanel x:Name="ComingUp"/>
        </StackPanel>

        <!-- Nothing connected: one quiet line that says where to go, naming BOTH providers. -->
        <StackPanel x:Name="ConnectHost" Margin="0,14,0,0">
            <TextBlock Text="UPCOMING" FontFamily="{StaticResource UiFont}" FontSize="10"
                       FontWeight="Bold" Foreground="{DynamicResource TextMid}"
                       Margin="1,0,0,8"/>
            <!-- Four words, not a sentence. The label was "Connect to Google or Outlook calendar
                 in Settings", which is an instruction printed on a button instead of a button
                 (owner: "the button itself is so long and so much text it cannot have that"). And
                 it now opens the Library's Settings scrolled to the calendar rows - the page that
                 can actually do it - rather than the notch's Settings, which cannot. -->
            <Button Style="{StaticResource RowButton}" Padding="10,9" Click="OnConnectCalendar"
                    ToolTip="Sign in to Google Calendar or Outlook">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"
                               Margin="0,0,9,0" IsHitTestVisible="False"/>
                    <TextBlock Grid.Column="1" Text="Connect a calendar" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                               FontSize="11" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Button>
        </StackPanel>

        <!-- ══ The Library door: bottom RIGHT, labelled, with its icon ══
             It was a bare "Library  >" text pill sharing a footer row with account admin, then an
             unlabelled icon in the header. Neither was a button you could read. This is a real pill
             with the shelf icon and the word, on the same Chip fill every other secondary action in
             the notch uses - so its shade and size are not a one-off any more. -->
        <Button HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource PillButton}"
                Background="{DynamicResource Chip}" Padding="13,7" Click="OnLibrary"
                ToolTip="Every meeting and note, searchable">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Library" Style="{StaticResource BodyStrong}"
                           Foreground="{DynamicResource TextHi}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
