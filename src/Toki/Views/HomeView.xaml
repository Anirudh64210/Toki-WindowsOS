<UserControl x:Class="Toki.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- The DEFAULT card of the 2026-08 redesign (figma 293:1830), on the glass notch:
           · greeting row - mascot, "Welcome back" 14 over TextHi, calendar + settings icons right
           · COMING UP - 10 Bold header at 50%, event rows as inner capsules (built in code)
           · two equal glass action buttons: "Start a meeting" + "Take Notes"
         The card's own padding is 17 (the frame's p-17); the window supplies the glass. -->
    <StackPanel Margin="17,14,17,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- No mascot HERE: in the redesign Toki floats BESIDE the notch card, in his own bubble
                 (PillWindow.MascotZone) - having one in the greeting row too put him on screen twice
                 (owner report, 2026-08-13). A hidden host keeps the pop/blink wiring alive without
                 drawing anything. -->
            <Viewbox Width="0" Height="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.9">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="TokiPop"/>
                </Viewbox.RenderTransform>
                <controls:TokiBlob x:Name="TokiChar"/>
            </Viewbox>
            <TextBlock x:Name="Greeting" Grid.Column="1" Text="Welcome back!"
                       FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="Medium"
                       Foreground="{DynamicResource TextHi}" Margin="1,0,0,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE787;" FontSize="13"
                        Foreground="{DynamicResource TextMid}"
                        ToolTip="See your week and create a meeting" Click="OnMeeting"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13"
                        Foreground="{DynamicResource TextMid}" Margin="2,0,0,0"
                        ToolTip="Settings" Click="OnSettings"/>
            </StackPanel>
        </Grid>

        <!-- Connected: the week, as the card's content. -->
        <StackPanel x:Name="ConnectedHost" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="COMING UP" FontFamily="{StaticResource UiFont}" FontSize="10"
                       FontWeight="Bold" Foreground="{DynamicResource TextMid}"
                       Margin="1,0,0,8"/>
            <StackPanel x:Name="ComingUp"/>
        </StackPanel>

        <!-- The two equal actions from the frame: Start a meeting · Take Notes. Glass capsules,
             height 40, radius 20 (a 40px-tall r24 collapses to a stadium anyway), icon + 13 Semibold. -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillButton}" Height="40" Padding="0,0"
                    Background="{DynamicResource GlassCapsule}" BorderThickness="0"
                    HorizontalContentAlignment="Center"
                    Click="OnMeeting" ToolTip="See your week and start or create a meeting">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource TextHi}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Start a meeting" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHi}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource PillButton}" Height="40" Padding="0,0"
                    Background="{DynamicResource GlassCapsule}" BorderThickness="0"
                    HorizontalContentAlignment="Center"
                    Click="OnTakeNotes" ToolTip="Start recording this meeting and take notes">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource TextHi}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Take Notes" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextHi}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Nothing connected yet: ONE quiet setup row (Google or Outlook on click) that disappears
             once connected - setup is an errand, not furniture. Below the actions, per the design's
             hierarchy: the verbs first, the errand under them. -->
        <StackPanel x:Name="ConnectHost">
            <Button x:Name="ConnectCalBtn" Margin="0,10,0,0" Style="{StaticResource PillButton}"
                    Background="Transparent" Padding="0,7" HorizontalContentAlignment="Center"
                    Click="OnConnectCalendar"
                    ToolTip="Connect Google Calendar or Outlook - your week shows up right here">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextMid}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnectCalLabel" Text="Connect a calendar" Foreground="{DynamicResource TextMid}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="&#x25BE;" FontFamily="{StaticResource UiFont}" FontSize="9"
                               Foreground="{DynamicResource TextMid}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Footer: connected-account marks (code-built) + the Library door. Quiet, under everything. -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="AccountsRow" Orientation="Horizontal" VerticalAlignment="Center"
                        MinHeight="26"/>
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Background="Transparent"
                    Foreground="{DynamicResource TextMid}" FontSize="10.5" Padding="12,6"
                    Content="Library  ›" Click="OnLibrary"/>
        </Grid>
    </StackPanel>
</UserControl>
