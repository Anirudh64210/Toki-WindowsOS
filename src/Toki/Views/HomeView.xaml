<UserControl x:Class="Toki.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- A simple vertical stack: ONE uniform gap between every element (header, buttons, Library),
         so the spacing reads even and sticky. Auto-height sizes the notch to this exactly. -->
    <StackPanel Margin="14,13,14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="30" RenderTransformOrigin="0.5,0.9">
                <Viewbox.RenderTransform>
                    <ScaleTransform x:Name="TokiPop"/>
                </Viewbox.RenderTransform>
                <controls:TokiBlob x:Name="TokiChar"/>
            </Viewbox>
            <TextBlock x:Name="Greeting" Grid.Column="1" Text="Welcome back!" Style="{StaticResource Body}"
                       FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                    ToolTip="Settings" Click="OnSettings"/>
        </Grid>

        <Button Margin="0,11,0,0" Style="{StaticResource PillButton}" Padding="0,10"
                HorizontalContentAlignment="Center" Click="OnTakeNotes"
                ToolTip="Start recording this meeting and take notes">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⁞⁞⁞" Foreground="{DynamicResource Amber}" Margin="0,0,8,0"/>
                <TextBlock Text="Take Notes"/>
            </StackPanel>
        </Button>

        <Button Margin="0,11,0,0" Style="{StaticResource WhiteButton}" Padding="0,10"
                HorizontalContentAlignment="Center"
                ToolTip="Google Calendar connect lands in Milestone 7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="G" FontWeight="Bold" Foreground="#4285F4" Margin="0,0,8,0"/>
                <TextBlock Text="Connect Google"/>
            </StackPanel>
        </Button>

        <Button Margin="0,11,0,0" Style="{StaticResource PillButton}" Background="Transparent"
                Padding="4,5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"
                FontSize="10.5" Content="Library  ›" Click="OnLibrary"/>
    </StackPanel>
</UserControl>
