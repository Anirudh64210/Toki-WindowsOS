<UserControl x:Class="Toki.Views.MeetingPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14,9" VerticalAlignment="Center">
        <TextBlock x:Name="Prompt" Text="Record this meeting?" Style="{StaticResource Body}"
                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
            <Button Style="{StaticResource CoralButton}" Content="Record" Padding="20,5"
                    Margin="0,0,8,0" Click="OnRecord"/>
            <Button Style="{StaticResource PillButton}" Content="Not now" Padding="14,5"
                    Foreground="{DynamicResource TextDim}" Click="OnDismiss"/>
        </StackPanel>
    </StackPanel>
</UserControl>
