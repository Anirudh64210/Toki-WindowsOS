<UserControl x:Class="Toki.Views.MeetingPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Menu Bar - Record This Meeting": ONE 169x40 glass pill, camera + 13 SemiBold label, and
         nothing else. The old three-button prompt ("Record this meeting?" over Record / Not now)
         asked a question the pill already answers by existing.

         Declining is the frame's own affordance from "Menu Bar - Idle (Close on Hover)": a 20px
         glass puck with a cross, sitting 10px past the right edge, revealed on hover. It is a real
         Button, so the whole puck is the hit target. -->
    <Grid Background="Transparent">
        <StackPanel x:Name="Pills" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
        <!-- The frame floats the puck clear of the pills, 8px past the right one, and reveals it on
             hover. It is ALWAYS visible here: hover-to-reveal made the only way to say no invisible
             until you found it, so the prompt read as having one button (owner: "the x button doesnt
             work, i cannot select it"). A prompt you cannot decline is not a prompt. It sits at 55%
             so it stays the quiet half of the pair without ever being hidden. -->
        <ContentControl x:Name="CloseHost" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Opacity="0.55"/>
    </Grid>
</UserControl>
