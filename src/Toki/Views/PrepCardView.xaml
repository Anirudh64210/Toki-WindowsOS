<UserControl x:Class="Toki.Views.PrepCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16,14,16,14">
        <!-- Title + "11:00 – 11:30 · in 2 min" (relative part amber, set in code), calendar shortcut top-right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Back to the recording page - only while a recording is running (owner flow). -->
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="13.5"
                        Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Back to recording" Click="OnBack"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Title" Style="{StaticResource Body}" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="WhenText" FontFamily="{StaticResource UiFont}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <!-- Which sticky note this meeting uses - an earlier one, or a new one. Toki never
                     guesses this from the meeting's title (titles change; "Weekly sync" is every
                     meeting), so the choice is explicit and remembered. -->
                <Button x:Name="NoteButton" Style="{StaticResource IconButton}" Content="&#xE8F1;" FontSize="13.5"
                        ToolTip="Which note to use for this meeting" Click="OnPickNote"/>
                <!-- Edit turns THIS CARD into a note you carry on writing in - the recap, open items and
                     agenda arrive as real text, tick boxes and bullets (owner, 2026-08-05). -->
                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="13.5"
                        ToolTip="Edit these notes" Click="OnEdit"/>
                <Button x:Name="CalendarButton" Style="{StaticResource IconButton}" Content="&#xE787;" FontSize="13.5"
                        ToolTip="Open calendar" Click="OnCalendar"/>
            </StackPanel>
        </Grid>

        <!-- Invited/accepted: overlapping initial avatars + "5 invited · 3 accepted" (real invite data only) -->
        <StackPanel x:Name="PeopleHost" Orientation="Horizontal" Margin="1,9,0,0" Visibility="Collapsed">
            <StackPanel x:Name="AvatarHost" Orientation="Horizontal" VerticalAlignment="Center"/>
            <TextBlock x:Name="PeopleText" Style="{StaticResource Dim}" FontSize="12" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- The prep context: one subtle inset box (the single deliberate box on this card).
             Replaced in place by the editor once you press Edit - same card, now writable. -->
        <Border x:Name="ContextBox" Background="{DynamicResource SurfaceHi}" CornerRadius="12"
                Padding="12,11,12,12" Margin="0,12,0,0">
            <StackPanel>
                <!-- LAST TIME -->
                <StackPanel x:Name="RecapHost" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{DynamicResource Pink}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecapHeader" Style="{StaticResource SectionHeader}" Margin="0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="RecapText" Style="{StaticResource Body}" FontSize="12"
                               Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" MaxHeight="52"
                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- First-time / no-match honest line (never shown together with LAST TIME) -->
                <StackPanel x:Name="FirstTimeHost" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="{DynamicResource Pink}" Margin="0,2,6,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="FirstTimeLine" Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="270" Text="First time with this one - I’ll take notes if you record."/>
                </StackPanel>

                <!-- STILL OPEN (rows built in code) -->
                <StackPanel x:Name="OpenHost" Visibility="Collapsed">
                    <TextBlock Text="STILL OPEN" Style="{StaticResource SectionHeader}" Margin="0,12,0,6"/>
                    <StackPanel x:Name="OpenRows"/>
                </StackPanel>

                <!-- AGENDA (bullets built in code) -->
                <StackPanel x:Name="AgendaHost" Visibility="Collapsed">
                    <TextBlock Text="AGENDA" Style="{StaticResource SectionHeader}" Margin="0,12,0,6"/>
                    <StackPanel x:Name="AgendaRows"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Edit mode: the same card, writable. Sits exactly where the context box was. -->
        <Border x:Name="ScratchHost" Visibility="Collapsed" Background="{DynamicResource SurfaceHi}"
                CornerRadius="12" Padding="12,10,12,12" Margin="0,12,0,0">
            <ContentControl x:Name="ScratchSlot"/>
        </Border>

        <!-- Full-width Join, with a quiet Later beneath -->
        <Button x:Name="JoinButton" Style="{StaticResource WhiteButton}" Padding="0,10" Margin="0,12,0,0"
                HorizontalContentAlignment="Center" Content="Join and record" Click="OnJoin"/>
        <Button x:Name="LaterButton" Style="{StaticResource PillButton}" Background="Transparent"
                Foreground="{DynamicResource TextDim}" FontSize="12" Padding="14,5" Margin="0,5,0,0"
                HorizontalAlignment="Center" Content="Later" Click="OnLater"/>
    </StackPanel>
</UserControl>
