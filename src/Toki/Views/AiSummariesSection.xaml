<UserControl x:Class="Toki.Views.AiSummariesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The AI-summaries block (mode + BYO-API-key flow), lifted whole from the notch SettingsView
         so it has ONE home: the Library's Settings page. All persistence goes through the same
         AppSettings paths as before - nothing here writes settings.json directly. -->
    <StackPanel>
        <!-- Mode selector. This lives in a WINDOW, not the notch, so it gets window-sized breathing room
             (owner 2026-08-05: "tight and ugly and close to each other"). The track is padded and the
             three segments carry their own side margins, so they never touch each other. -->
        <Border Background="{DynamicResource SurfaceHi}" CornerRadius="14" Padding="5" Margin="0,14,0,0"
                MaxWidth="520" HorizontalAlignment="Left">
            <UniformGrid x:Name="NotesModeSeg" Columns="3"/>
        </Border>

        <!-- On-device options -->
        <StackPanel x:Name="LocalOptions">
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Use graphics card" Style="{StaticResource BodyStrong}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <CheckBox x:Name="GpuToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}"
                          VerticalAlignment="Center" Click="OnGpuToggle"/>
            </Grid>
        </StackPanel>

        <!-- BYO API key: provider (sets the address) → key → model. -->
        <StackPanel x:Name="ApiOptions" Visibility="Collapsed" MaxWidth="400" HorizontalAlignment="Left">
            <TextBlock Text="Provider" Style="{StaticResource BodyStrong}" Margin="0,16,0,6"/>
            <ContentControl x:Name="ProviderHost"/>

            <!-- Only when Provider = Custom: the address is otherwise set for you. -->
            <StackPanel x:Name="CustomEndpointRow" Visibility="Collapsed">
                <TextBlock Text="Address" Style="{StaticResource BodyStrong}" Margin="0,14,0,6"/>
                <Border x:Name="ApiBaseUrlRim" Background="{DynamicResource SurfaceHi}" CornerRadius="9" Padding="11,0"
                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                    <TextBox x:Name="ApiBaseUrlBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                             Height="34" FontSize="11.5" FontFamily="{StaticResource UiFont}"
                             VerticalContentAlignment="Center" LostFocus="OnApiFieldCommitted"/>
                </Border>
                <TextBlock Style="{StaticResource Dim}" FontSize="10" LineHeight="14" Margin="2,5,0,0"
                           TextWrapping="Wrap"
                           Text="The service's address, ending in /v1 (e.g. https://api.together.xyz/v1)."/>
            </StackPanel>

            <TextBlock Text="Your API key" Style="{StaticResource BodyStrong}" Margin="0,14,0,6"/>
            <Border x:Name="ApiKeyRim" Background="{DynamicResource SurfaceHi}" CornerRadius="9" Padding="11,0"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                <PasswordBox x:Name="ApiKeyBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Text}" Height="34" FontSize="11.5"
                             FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center"
                             LostFocus="OnApiFieldCommitted"/>
            </Border>

            <TextBlock Text="Model" Style="{StaticResource BodyStrong}" Margin="0,14,0,6"/>
            <ContentControl x:Name="ModelHost"/>
            <TextBlock x:Name="ModelHint" Style="{StaticResource Dim}" FontSize="10" LineHeight="14"
                       TextWrapping="Wrap" Margin="2,5,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="TestApiButton" Style="{StaticResource PillButton}" Content="Test connection"
                        Padding="18,8" Click="OnTestApi"/>
                <Button x:Name="RemoveKeyButton" Style="{StaticResource PillButton}" Background="Transparent"
                        Foreground="{DynamicResource Coral}" Content="Remove key" Padding="14,8" Margin="8,0,0,0"
                        ToolTip="Delete your key and go back to the on-device model" Click="OnRemoveKey"/>
            </StackPanel>
            <TextBlock x:Name="ApiTestStatus" Style="{StaticResource Dim}" FontSize="11" LineHeight="15"
                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Model status: informational, for On-device / Heuristic. Hidden in API-key mode, where the
             status line + model dropdown already say everything. -->
        <TextBlock x:Name="ModelStatus" Style="{StaticResource Dim}" FontSize="11" Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
