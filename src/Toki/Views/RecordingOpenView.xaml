<UserControl x:Class="Toki.Views.RecordingOpenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- Expanded recording controls, Glass/Luma-compact: ONE header row (tiny Toki + pulsing coral
         dot + elapsed time · compact Stop on the right), a hairline divider, and the live transcript
         line under it. The dot + timer ARE the recording cue — no separate "Recording" label, no
         stacked full-width button, no dead vertical space. Click the header (or Toki) to collapse
         back to the out-of-the-way peek. -->
    <!-- The live line stays a single line (latest utterance) so the auto-height notch never jumps
         as text arrives. Auto-height sizes the notch to exactly this content. -->
    <StackPanel Margin="14,10,14,11">
        <Grid Background="Transparent" MouseLeftButtonUp="OnCollapse" Cursor="Hand" ToolTip="Collapse">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Viewbox x:Name="TokiBox" Width="18" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.9">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="TokiPop"/>
                    </Viewbox.RenderTransform>
                    <controls:TokiBlob/>
                </Viewbox>
                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Coral}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="Timer" Text="0:00" Style="{StaticResource Body}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Mid-meeting door to the prep card + its scratchpad. Only shown when there IS a
                     card for this meeting; a Back button there returns here. (Owner flow, 2026-08-05.) -->
                <Button x:Name="PrepButton" Style="{StaticResource PillButton}" FontSize="11"
                        Padding="10,5" Margin="0,0,6,0" Visibility="Collapsed"
                        Content="Prep card" Click="OnPrep"
                        ToolTip="Your prep notes for this meeting — jot things down while you talk"/>
                <Button Style="{StaticResource CoralButton}" FontSize="11" Padding="11,5"
                        Click="OnStop" ToolTip="Stop recording">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Divider, not a box (design rule) — separates the controls from the live transcript. -->
        <Rectangle Height="1" Fill="{DynamicResource Hairline}" Margin="0,9,0,0"
                   SnapsToDevicePixels="True"/>

        <!-- Live transcript: the most recent finalized line, fading in as Toki hears it. -->
        <TextBlock x:Name="LiveLine" Margin="0,8,0,0" Text="Listening…" Style="{StaticResource Body}"
                   FontSize="11.5" Foreground="{DynamicResource TextDim}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
