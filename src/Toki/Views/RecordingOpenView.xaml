<UserControl x:Class="Toki.Views.RecordingOpenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- THE RECORDING BAR of the redesign, from two frames:
           · "Menu Bar - Transcribing"        - the compact bar (320x50 in the frame)
           · "Live Transcription (Expanded)"  - the same bar with the live transcript under it (344 wide)
         A single chevron in a glass puck toggles between them, turning over to say which way it
         goes. The frames draw stacked up-and-down chevrons there; the owner overruled that detail on
         2026-08-18 and the owner outranks the frame. The peek before this (the tiny upside-down
         Toki) is unchanged: opening the peek lands you here, on the bar.

         Widths differ from the frames by design: the frames reserve 64px of left padding INSIDE the
         pill for a mascot that overlaps it, and Toki floats BESIDE the card here (the owner's 10px
         air gap, 2026-08-14). The content row keeps the frame's own 242px, so what you see between
         the rounded corners is the frame's row at the frame's spacing.

         There is deliberately NO pause button. The frame draws one, but nothing in the audio layer
         can pause a capture, and a control wired to nothing is worse than no control. -->
    <StackPanel>
        <!-- ── the bar row (identical in both forms - the frames' "Frame 7") ── -->
        <!-- Auto/*/Auto/*/Auto IS css space-between: the two star columns are the equal gaps. -->
        <!-- Clicking the bar itself (never the controls on it - those are real Buttons and swallow
             the click) collapses back to the out-of-the-way peek, as it always has. -->
        <!-- 12px above and below a 26px row is the frame's 50px pill. The row is 26, not the frame's
             24, because the GLASS PUCK on it is 26: a 26px control in a 24px row gets a layout clip,
             which sliced the bottom off the chevron's disc and cropped its shadow rings flat. The row
             sizes to its tallest control; the pill height it adds up to is unchanged.
             18 left / 16 right, and the chevron now hangs only 2px past it rather than 6. It used to
             measure 8px of optical right inset against 18 on the left, so the control cluster sat
             visibly nearer its corner than the timer did to its own. -->
        <Grid x:Name="BarRow" Margin="18,12,16,12" Height="26" Background="Transparent"
              MouseLeftButtonUp="OnCollapse" Cursor="Hand" ToolTip="Collapse">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Amber, not white: one meaning one colour, and amber is time everywhere else in Toki. -->
            <!-- TABULAR figures. This ticks every second, and proportional digits are different
                 widths, so 0:09 to 0:10 changed the timer's width and nudged everything beside it
                 once a second for the whole meeting. Tabular numerals are why clocks do not wobble. -->
            <TextBlock x:Name="Timer" Grid.Column="0" Text="0:00"
                       FontFamily="{StaticResource UiFont}" FontSize="13.5" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource Amber}" VerticalAlignment="Center"/>

            <!-- STAYS IN THE MIDDLE COLUMN. Spanning the whole row and centring on the card was
                 tried (2026-09-03) so the wave would sit on the card's true centreline rather than
                 midway between a narrow timer and a wide control cluster. Rendered, it overlapped the
                 ghost and stop buttons - the wave stretches to its span, so a full-row span makes it
                 wide enough to run under them. A few px off centre is a smaller fault than colliding
                 with the controls, and space-between is what the frame specifies anyway. -->
            <controls:VoiceWave x:Name="Wave" Grid.Column="2" BarCount="14" Height="20"
                                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Mid-meeting door to the prep card + its scratchpad. Only when this meeting HAS a
                     card; it lives in the expanded form, where the frame has room for it. -->
                <Button x:Name="PrepButton" Style="{StaticResource PillButton}" FontSize="12"
                        MinHeight="24" Padding="10,0" Margin="0,0,8,0" Visibility="Collapsed"
                        Content="Prep card" Click="OnPrep"
                        ToolTip="Your prep notes for this meeting - jot things down while you talk"/>
                <!-- Ghost toggle: hide/show Toki in screen recordings without leaving the bar - for
                     when you started recording and only then realised ghost mode was off. Built in
                     code so the glass puck (not the glyph) is the hit target. -->
                <ContentControl x:Name="GhostHost" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <!-- Stop: the themed StopRed disc with a white rounded square (built in code so the
                     disc, not the glyph, is the hit target). -->
                <ContentControl x:Name="StopHost" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <ContentControl x:Name="ExpandHost" VerticalAlignment="Center" Margin="0,0,-2,0"/>
            </StackPanel>
        </Grid>

        <!-- ── the expanded form's live transcript ──
             The frame fades the oldest line out at the top with a gradient mask; an OpacityMask is
             the composition-only way to do that in WPF (no Effect, so nothing here forces a
             software render). Newest line at the bottom, as the frame stacks them. -->
        <Grid x:Name="LiveHost" Visibility="Collapsed" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="111"/>
            </Grid.RowDefinitions>

            <!-- Readiness cue: a soft pulsing dot + "Live" telling the user transcription is running
                 right now. Hidden until the streaming preview is actually active (LiveReady). -->
            <StackPanel x:Name="LiveHeader" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6"
                        Visibility="Collapsed" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource Coral}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Live" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextDim}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- ── the expanded form's live transcript ──
                     The frame fades the oldest line out at the top with a gradient mask; an OpacityMask is
                     the composition-only way to do that in WPF (no Effect, so nothing here forces a
                     software render). Newest line at the bottom, as the frame stacks them. -->
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.22"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <StackPanel x:Name="LiveLines" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
