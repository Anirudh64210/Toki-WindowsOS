<UserControl x:Class="Toki.Views.RecordingOpenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- Expanded recording controls: the elapsed time + a live "Recording" cue + Stop.
         No live transcript here (that's parked) — this used to show fake placeholder
         lines during a real recording, which read as a lie. Click the header (or the
         tiny Toki) to collapse back to the out-of-the-way character. -->
    <DockPanel Margin="16,12,16,13" LastChildFill="False">
        <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonUp="OnCollapse" Cursor="Hand"
              ToolTip="Collapse">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox x:Name="TokiBox" Width="22" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.9">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="TokiPop"/>
                    </Viewbox.RenderTransform>
                    <controls:TokiBlob/>
                </Viewbox>
                <TextBlock x:Name="Timer" Text="0:00" Style="{StaticResource Body}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Coral}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Recording" Style="{StaticResource Body}" FontSize="11"
                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource CoralButton}" Margin="0,13,0,0"
                Padding="0,9" HorizontalContentAlignment="Center" Click="OnStop">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White"
                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="Stop"/>
            </StackPanel>
        </Button>
    </DockPanel>
</UserControl>
