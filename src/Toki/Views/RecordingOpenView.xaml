<UserControl x:Class="Toki.Views.RecordingOpenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <UserControl.Resources>
        <Style x:Key="SpeakerChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Chip}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1.5"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,7,0"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style x:Key="Line" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="14,10,14,12">
        <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonUp="OnCollapse" Cursor="Hand">
            <TextBlock x:Name="Timer" Text="0:00" Style="{StaticResource Body}"
                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"/>
            <controls:Waveform HorizontalAlignment="Right"/>
        </Grid>
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Style="{StaticResource StarButton}" HorizontalAlignment="Left" Click="OnStar">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="★" Margin="0,0,5,0"/>
                    <TextBlock Text="Star this"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CoralButton}" HorizontalAlignment="Right" Click="OnStop">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="White"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Stop &amp; summarize"/>
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <Border Style="{StaticResource SpeakerChip}">
                        <TextBlock Text="THEM" Style="{StaticResource ChipText}"/>
                    </Border>
                    <TextBlock Text="Love it. What's left before we ship?" Style="{StaticResource Line}" Width="270"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,9">
                    <TextBlock Text="Brand font and hex, and the Make webhook URL."
                               Style="{StaticResource Line}" TextAlignment="Right" Width="260"/>
                    <Border Style="{StaticResource SpeakerChip}" Margin="7,1,0,0"
                            Background="{StaticResource BlueDark}">
                        <TextBlock Text="YOU" Style="{StaticResource ChipText}" Foreground="{StaticResource Blue}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                    <Border Style="{StaticResource SpeakerChip}">
                        <TextBlock Text="THEM" Style="{StaticResource ChipText}"/>
                    </Border>
                    <TextBlock Text="Perfect — I'll send both after this call." Style="{StaticResource Line}" Width="270"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SpeakerChip}" Background="{StaticResource AmberDark}">
                        <TextBlock Text="THEM" Style="{StaticResource ChipText}" Foreground="{StaticResource Amber}"/>
                    </Border>
                    <TextBlock Text="Live transcript appears here in Milestone 4."
                               Style="{StaticResource Line}" Foreground="{StaticResource Amber}" Width="270"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
