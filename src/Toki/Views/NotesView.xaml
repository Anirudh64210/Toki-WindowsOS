<UserControl x:Class="Toki.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <DockPanel Margin="16,12,16,10">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource AmberDark}" CornerRadius="8" Width="28" Height="28">
                <TextBlock Text="▪▪" Foreground="{DynamicResource Amber}" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="Transcript" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subtitle" Text="" Style="{StaticResource Dim}" FontSize="9.5"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CopyBtn" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                        ToolTip="Copy transcript" Click="OnCopy"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE740;"
                        ToolTip="Open in Library window" Click="OnMaximise"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                        ToolTip="Close" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- Keep-or-discard: you decide whether this meeting stays in your Library. -->
        <Grid x:Name="ActionBar" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PillButton}" Background="Transparent"
                    Foreground="{StaticResource Coral}" Padding="14,7" Content="Delete"
                    ToolTip="Discard this meeting — remove it and its audio" Click="OnDelete"/>
            <Button Grid.Column="1" Style="{StaticResource WhiteButton}" Padding="0,8" Margin="10,0,0,0"
                    HorizontalContentAlignment="Center" Content="Save to Library"
                    ToolTip="Keep this meeting in your Library" Click="OnSaveToLibrary"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" controls:SmoothScroll.Enabled="True">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
