<UserControl x:Class="Toki.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16,12,16,10">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AmberDark}" CornerRadius="8" Width="28" Height="28">
                <TextBlock Text="▪▪" Foreground="{StaticResource Amber}" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="Transcript" Style="{StaticResource Body}" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subtitle" Text="" Style="{StaticResource Dim}" FontSize="9.5"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="✕" Click="OnClose"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceHi}" CornerRadius="10"
                Padding="11,7" Margin="0,11,0,0">
            <TextBlock Text="Search this transcript — you: / them:" Style="{StaticResource Dim}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
