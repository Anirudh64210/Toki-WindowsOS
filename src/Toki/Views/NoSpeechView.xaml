<UserControl x:Class="Toki.Views.NoSpeechView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16,12" VerticalAlignment="Center">
        <TextBlock Text="Nothing was said — nothing saved." Style="{StaticResource Body}"
                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Silent meetings never clutter your Library." Style="{StaticResource Dim}"
                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
        <Button Style="{StaticResource PillButton}" Content="Okay" Padding="20,5"
                HorizontalAlignment="Center" Margin="0,9,0,0" Click="OnClose"/>
    </StackPanel>
</UserControl>
