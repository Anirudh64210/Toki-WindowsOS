<UserControl x:Class="Toki.Views.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Toki.Controls">
    <!-- The one editable note surface, reused by the Library's hand-written notes, the prep card and
         the in-meeting scratchpad. Deliberately small: sizes, to-dos, lists, spacing, templates.
         NO font family and NO colour - owner, 2026-08-05.

         The toolbar WRAPS, because this same control has to work at 356px inside the notch and at
         full width in the Library window. -->
    <!-- NO PERMANENT TOOLBAR (2026-08-23). It sat above every note, cost a row of a 356px panel,
         and named things badly ("Steps", "Style", "Aa 10"). Commands now live behind "/" at the
         caret, and a blank note carries one faint hint saying so. The writing surface is the whole
         control, which is what makes it read as a page rather than as a form. -->
    <Grid>
        <!-- The hint sits UNDER the editor, not inside the document: text in the document would be
             text the user has to delete, and would land in the saved Markdown. -->
        <!-- The left inset is SET IN CODE (PlaceHint), from where the document actually draws its
             first character. It was pinned here at 1px while the editor's own content starts at 5, so
             the placeholder sat to the LEFT of the cursor and the caret landed inside the W of
             "Write". Measured, not guessed, because the origin moves with the text size. -->
        <TextBlock x:Name="Hint" IsHitTestVisible="False"
                   Text="Write, or press / for commands"
                   Foreground="{DynamicResource TextLow}" FontFamily="{StaticResource UiFont}"
                   FontSize="13" Margin="4,0,0,0" VerticalAlignment="Top"/>

        <RichTextBox x:Name="Editor"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                     SelectionBrush="{DynamicResource Pink}" SelectionOpacity="0.3"
                     FontFamily="{StaticResource UiFont}" FontSize="13"
                     AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     controls:SmoothScroll.Enabled="True"
                     SpellCheck.IsEnabled="True"/>
    </Grid>
</UserControl>
