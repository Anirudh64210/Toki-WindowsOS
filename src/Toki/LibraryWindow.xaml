<Window x:Class="Toki.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Toki.Controls"
        xmlns:views="clr-namespace:Toki.Views"
        Title="Toki" Height="640" Width="960" MinWidth="720" MinHeight="460"
        WindowStartupLocation="Manual" Background="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0,0">
        <Grid.ColumnDefinitions>
            <!-- Nav sidebar is a FIXED rail (no drag-resizer) - Ask/Library/Templates don't need resizing. -->
            <ColumnDefinition x:Name="SidebarCol" Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Sidebar: mascot · nav · back ═══════════ -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}">
            <DockPanel Margin="18,20,14,16">
                <!-- The LOGO ROW of the redesign (figma 349:6743): the blue cloud small, with the
                     "Toki" wordmark beside it - an identity, not a toy taking a quarter of the rail.
                     Still clickable for the reaction vocabulary. -->
                <Border DockPanel.Dock="Top" x:Name="MascotBtn" Background="Transparent" Cursor="Hand"
                        HorizontalAlignment="Left" Margin="4,2,0,22" ToolTip="Poke Toki"
                        MouseLeftButtonUp="OnMascotClick">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="30" Height="27" RenderTransformOrigin="0.5,0.9">
                            <Viewbox.RenderTransform><ScaleTransform x:Name="MascotPop"/></Viewbox.RenderTransform>
                            <controls:TokiBlob x:Name="SideToki"/>
                        </Viewbox>
                        <TextBlock Text="Toki" FontFamily="{StaticResource UiFont}" FontSize="16"
                                   FontWeight="Bold" Foreground="{DynamicResource Text}"
                                   VerticalAlignment="Center" Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Back to Toki (bottom) -->
                <!-- Content (chevron+label) is set in code so both pieces are vertically centered. -->
                <Button DockPanel.Dock="Bottom" x:Name="BackBtn" Style="{StaticResource PillButton}"
                        Background="{DynamicResource SurfaceHi}"
                        HorizontalContentAlignment="Center" Padding="13,9" FontSize="11.5" Click="OnBack"/>

                <!-- Nav items (built in code so the active one highlights) -->
                <StackPanel x:Name="Nav" DockPanel.Dock="Top"/>
            </DockPanel>
        </Border>

        <!-- ═══════════ Main pane ═══════════ -->
        <Border Grid.Column="1" Background="{DynamicResource Ink}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0">
            <Grid x:Name="MainHost">

                <!-- ── Ask (conversation + landing) ── -->
                <Grid x:Name="AskPage">
                    <!-- The redesign's ambient depth (figma 348:5438): a cool teal-blue bloom rising
                         from the bottom of the page - the one page with atmosphere, because it is the
                         one page that is a conversation, not a document. Purely decorative. -->
                    <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="420">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                <GradientStop Color="#3D103C46" Offset="0"/>
                                <GradientStop Color="#1E10333E" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <DockPanel>
                        <!-- Top bar: current chat title, History (past conversations), and New chat. -->
                        <Grid DockPanel.Dock="Top" Margin="40,16,40,0">
                            <TextBlock x:Name="ChatTitle" Style="{StaticResource Dim}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ask Toki"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="HistoryBtn" Style="{StaticResource PillButton}" Background="{DynamicResource Chip}"
                                        Padding="13,7" FontSize="11.5" Click="OnHistory">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="History" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- New Chat is the WHITE pill (figma): the one primary action on this bar. -->
                                <Button x:Name="NewChatBtn" Style="{StaticResource WhiteButton}"
                                        Padding="13,7" FontSize="11.5" Margin="8,0,0,0" Click="OnNewChat" Content="+  New Chat"/>
                            </StackPanel>
                        </Grid>

                        <!-- Input bar - always docked at the bottom. -->
                        <!-- The redesign's prompt bar: a full capsule (r26) with the mic and a ROUND
                             send button seated at its right edge - one soft pill, not a box with icons. -->
                        <Border DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" MaxWidth="720"
                                Margin="40,10,40,28" Background="{DynamicResource SurfaceHi}" CornerRadius="26"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="10,6,7,6" Cursor="IBeam">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AskBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                         FontSize="14" VerticalContentAlignment="Center" Padding="12,11"
                                         FontFamily="{StaticResource UiFont}" KeyDown="OnAskKeyDown"/>
                                <!-- Voice overlay: replaces the box while listening / transcribing (Google-/Safari-
                                     style). A pulsing dot + status word; the mic drives it in code. -->
                                <StackPanel x:Name="VoiceStatus" Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                    <Ellipse x:Name="VoiceDot" Width="9" Height="9" Fill="{DynamicResource Coral}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="VoiceStatusText" Text="Listening…" FontSize="14"
                                               Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource UiFont}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="MicBtn" Style="{StaticResource IconButton}"
                                        Content="&#xE720;" ToolTip="Ask by voice" Click="OnMic" VerticalAlignment="Center"/>
                                <!-- The circular send: a filled disc so the bar ends in one clear action. -->
                                <Border Grid.Column="2" Background="{DynamicResource Chip}" CornerRadius="18"
                                        Width="36" Height="36" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="AskBtn" Style="{StaticResource IconButton}" Width="36" Height="36"
                                            Content="&#xE724;" ToolTip="Ask" Click="OnAsk"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Conversation scroll: the landing (greeting + suggestions) when empty; the Q&A thread once asked.
                             A floating "↓ Latest" pill (same as the notch AskView's JumpPill) appears when you've scrolled
                             UP away from the newest message - click = smooth-scroll to the end + re-anchor. -->
                        <Grid>
                            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" controls:SmoothScroll.Enabled="True">
                                <Grid>
                                    <!-- Ask landing - the welcome (Luma-style: a confident hero, one identity
                                         line, chips that invite action; soft pink depth from the mascot). -->
                                    <StackPanel x:Name="Landing" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Margin="40,20">
                                        <!-- Hero: the mascot on a soft radial pink glow - subtle depth, not decoration. -->
                                        <Grid x:Name="LandingHero" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <!-- Soft BLUE glow (the mascot went blue with the redesign; the pink
                                                 halo read as a leftover of the old character). -->
                                            <Ellipse Width="240" Height="150" IsHitTestVisible="False">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush>
                                                        <GradientStop Color="#333D9BEA" Offset="0"/>
                                                        <GradientStop Color="#003D9BEA" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Border Background="Transparent" Cursor="Hand" ToolTip="Poke Toki"
                                                    MouseLeftButtonUp="OnLandingMascotClick">
                                                <Viewbox Width="88" Height="78">
                                                    <controls:TokiBlob x:Name="LandingToki"/>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="Greeting" Style="{StaticResource Body}" FontSize="30" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AskHint" Style="{StaticResource Dim}" FontSize="12.5" TextAlignment="Center"
                                                   Margin="0,10,0,26" TextWrapping="Wrap"/>
                                        <WrapPanel x:Name="Suggestions" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel x:Name="Messages" HorizontalAlignment="Stretch" MaxWidth="720"
                                                Margin="40,28,40,20" Visibility="Collapsed"/>
                                </Grid>
                            </ScrollViewer>
                            <Border x:Name="ChatJumpPill" Visibility="Collapsed" Opacity="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    Background="{DynamicResource Chip}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                    CornerRadius="13" Padding="11,5" Cursor="Hand" MouseLeftButtonUp="OnChatJumpToLatest">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9.5"
                                               Foreground="{DynamicResource Pink}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Latest" FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- ── Library (list + detail) ── -->
                <Grid x:Name="LibraryPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <!-- Fixed note-list column - no drag-resizer (owner: remove the VS Code resizer). -->
                        <ColumnDefinition x:Name="ListCol" Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NOT an inset Surface box: the list sits on the same background as the note pane and
                         fills its column edge-to-edge (like the Ask panel). No outer margin/box = no strip
                         of background showing between the box and the divider. Only the children carry a
                         small inner inset so text isn't flush to the edges. -->
                    <DockPanel x:Name="ListPanel" Grid.Column="0" Margin="20,18,16,0">
                        <!-- Title row: "Library" + count on the left; small New-note (+) and book "My notes"
                             filter on the right, vertically centred on the title. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <!-- Same SemiBold weight as the Settings/Templates headers (smaller, because
                                     it sits in the narrow list column above the search box). -->
                                <TextBlock Text="Library" Style="{StaticResource Body}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CountLabel" Style="{StaticResource Dim}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MyNotesToggle" Style="{StaticResource IconButton}" Content="&#xE736;"
                                        Click="OnToggleMyNotes"/>
                                <Button x:Name="NewNoteBtn" Style="{StaticResource IconButton}" Content="&#xE710;"
                                        Margin="2,0,0,0" ToolTip="New note" Click="OnNewNote"/>
                            </StackPanel>
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceHi}" CornerRadius="10" Padding="12,0" Cursor="IBeam"
                                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                         VerticalContentAlignment="Center" Height="36" FontSize="12.5" TextChanged="OnSearch"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Sort/filter menu: Newest/Oldest/Longest/Shortest/Open tasks. -->
                                <Button x:Name="SortBtn" Style="{StaticResource IconButton}"
                                        Margin="6,0,0,0" Content="&#xE8CB;" ToolTip="Sort &amp; filter" Click="OnSortMenu"/>
                            </StackPanel>
                        </Grid>

                        <!-- The meeting list only builds the rows that are on screen. The ScrollViewer is
                             INSIDE the control's template on purpose: an ItemsControl wrapped in an outer
                             ScrollViewer is measured with infinite height, so every row is realised and
                             virtualization does nothing. ScrollUnit=Pixel keeps SmoothScroll's per-pixel
                             glide (item-unit scrolling would jump a whole card per notch).
                             The empty state is an overlay, not a row, so it can't be virtualized away. -->
                        <Grid>
                            <views:MeetingList x:Name="Cards"
                                               VirtualizingPanel.IsVirtualizing="True"
                                               VirtualizingPanel.VirtualizationMode="Recycling"
                                               VirtualizingPanel.ScrollUnit="Pixel">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"
                                                      Focusable="False" controls:SmoothScroll.Enabled="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </views:MeetingList>
                            <TextBlock x:Name="CardsEmpty" Style="{StaticResource Dim}" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0"
                                       VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>

                    <!-- One subtle hairline divides the list from the note (the splitter that used to draw
                         the seam is gone). -->
                    <Border Grid.Column="1" Background="{DynamicResource Ink}"
                            BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0">
                        <!-- ONE scroll fills the whole pane: the note (toolbar → title → body) is a single
                             RichTextBox, so its scrollbar runs the FULL height from the very top of the pane,
                             like a normal app scroll - not starting below a pinned toolbar. Left/right padding
                             lives inside the RichTextBox so the scrollbar sits flush at the pane's right edge. -->
                        <ContentControl x:Name="DetailBody"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Border>
                </Grid>

                <!-- ── Templates ── -->
                <!-- Left-aligned with the SAME padding as Settings: every page in this window starts at
                     the same left edge, so switching tabs doesn't shift the text under you. (Templates
                     was the one centred page.) -->
                <ScrollViewer x:Name="TemplatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="40,34,40,34" controls:SmoothScroll.Enabled="True">
                    <StackPanel x:Name="TemplatesList" MaxWidth="640" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- ── Settings - THE home for preferences: name · appearance · AI summaries · calendar
                        · about. Dividers-not-boxes: hairlines separate the sections. ── -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Padding="40,34,40,34" controls:SmoothScroll.Enabled="True">
                    <!-- The redesign's settings page (figma 353:9154): ONE centred column, each section a
                         big title + a dim one-line explainer + a rounded CARD of rows. -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                            <!-- Bottom-aligned with a nudge - WPF has no Baseline alignment for siblings. -->
                            <TextBlock Text="Toki 1.0" Style="{StaticResource Dim}" FontSize="11.5"
                                       VerticalAlignment="Bottom" Margin="14,0,0,4"/>
                        </StackPanel>

                        <TextBlock Text="What should Toki call you?" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource SurfaceHi}" CornerRadius="14" Padding="14,0"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <TextBox x:Name="LibNameBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                     Height="46" FontSize="15" FontFamily="{StaticResource UiFont}"
                                     VerticalContentAlignment="Center" MaxLength="40"
                                     TextChanged="OnLibNameChanged" KeyDown="OnLibNameKey"/>
                        </Border>

                        <!-- Confirm / cancel only appear once there's an unsaved change. -->
                        <StackPanel x:Name="LibNameActions" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <Button x:Name="LibNameSave" Style="{StaticResource WhiteButton}" Content="Save"
                                    Padding="26,9" Click="OnLibNameSave"/>
                            <Button x:Name="LibNameCancel" Style="{StaticResource PillButton}" Background="Transparent"
                                    Content="Cancel" Padding="20,9" Margin="8,0,0,0" Click="OnLibNameCancel"/>
                        </StackPanel>

                        <!-- Positive reinforcement after a successful save. -->
                        <StackPanel x:Name="LibNameSaved" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LibNameSavedText" Style="{StaticResource Body}" FontSize="12.5"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ── Appearance: the redesign's CARD of rows - one rounded surface, rows split
                             by hairlines, the switch on the right. Directly under the name, as the frame
                             orders it (353:9154). ── -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="How Toki sits on your screen and in what you share."
                                   Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,14"/>
                        <Border Background="{DynamicResource SurfaceHi}" CornerRadius="16"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="16,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dark theme" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LibThemeToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}"
                                              VerticalAlignment="Center" Click="OnLibThemeToggle"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Hairline}" Margin="16,0"/>
                                <Grid Margin="16,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Glassy notch" Style="{StaticResource BodyStrong}"/>
                                        <TextBlock Text="Let more of your screen show through the notch."
                                                   Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox x:Name="LibGlassToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}"
                                              VerticalAlignment="Center" Click="OnLibGlassToggle"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Hairline}" Margin="16,0"/>
                                <Grid Margin="16,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Show Toki in screen recordings" Style="{StaticResource BodyStrong}"/>
                                        <TextBlock Text="Off = invisible to recordings and screen shares."
                                                   Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox x:Name="LibGhostToggle" Grid.Column="1" Style="{StaticResource TokiSwitch}"
                                              VerticalAlignment="Center" Click="OnLibGhostToggle"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Names Toki should always get right ──
                             The roster behind speaker naming and name correction. AppSettings.PinnedNames
                             has been read by NameLexicon since T2, but nothing could ever write it - the
                             escape hatch existed with no handle on it. A name typed here is TRUSTED: it
                             beats what the recogniser heard, it lets a spoken name be attached to a voice,
                             and it is the only fix for a name the library cannot settle by frequency. -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="People Toki should spell right" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left"
                                   Text="Names your meetings use often. Toki trusts these over what it thinks it heard, and uses them to put a name to a voice. One per line, or separated by commas."/>
                        <Border Background="{DynamicResource SurfaceHi}" CornerRadius="12" Padding="14,10"
                                BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                Width="340" HorizontalAlignment="Left">
                            <TextBox x:Name="LibPinnedBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                                     MinHeight="72" MaxHeight="150" FontSize="13.5" FontFamily="{StaticResource UiFont}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnLibPinnedChanged"/>
                        </Border>

                        <StackPanel x:Name="LibPinnedActions" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <Button x:Name="LibPinnedSave" Style="{StaticResource WhiteButton}" Content="Save"
                                    Padding="26,9" Click="OnLibPinnedSave"/>
                            <Button Style="{StaticResource PillButton}" Background="Transparent"
                                    Content="Cancel" Padding="20,9" Margin="8,0,0,0" Click="OnLibPinnedCancel"/>
                        </StackPanel>
                        <StackPanel x:Name="LibPinnedSaved" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LibPinnedSavedText" Style="{StaticResource Body}" FontSize="12.5"
                                       Foreground="{DynamicResource Green}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ── Re-clean saved transcripts ──
                             OFFERED, never automatic. Every improvement to turn-merging or name
                             correction makes older transcripts look worse, and the tempting move is to
                             fix them quietly at startup. A transcript is a record of what people said;
                             rewriting one the user has already read is not a favour. So: a button, a
                             plain statement of what it will and will not touch, and a count afterwards. -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="Re-clean saved transcripts" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,6,0,12" MaxWidth="420" HorizontalAlignment="Left"
                                   Text="Runs today's transcript clean-up over meetings you already have: joins split-up lines back into whole turns, spells names the way you do, and drops the discarded half of spoken corrections. Your summaries, to-dos and tick boxes are not touched."/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LibRecleanButton" Style="{StaticResource PillButton}"
                                    Background="{DynamicResource Chip}" Content="Re-clean transcripts"
                                    Padding="18,9" Click="OnLibReclean"/>
                            <TextBlock x:Name="LibRecleanStatus" Style="{StaticResource Dim}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- ── AI summaries (the mode + BYO-API-key flow, moved whole from the notch) ── -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="AI summaries" Style="{StaticResource SectionTitle}"/>
                        <views:AiSummariesSection x:Name="AiSection"/>

                        <!-- ── Calendars ──
                             TWO independent connections, not a choice between them. A work Outlook
                             calendar and a personal Google one is an ordinary combination, and a
                             notetaker watching only one of them misses half the meetings without ever
                             saying so. Connect either, or both; the agenda is merged.

                             A CONNECTED row shrinks to a small provider mark plus the account it is
                             signed in as (owner's ask): once it is done, it is a fact to confirm at a
                             glance, not an action taking up a button's worth of space. -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="Calendars" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,6,0,14" MaxWidth="420" HorizontalAlignment="Left"
                                   Text="Connect one or both. Toki shows them as a single agenda and never writes a change back to the wrong account."/>

                        <!-- Google -->
                        <Grid x:Name="LibGoogleRow">
                            <!-- Three columns, not a horizontal stack: a StackPanel measures its
                                 children with INFINITE width, so a wrapping status line simply ran
                                 underneath the button instead of wrapping before it. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LibGoogleMark" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Chip}" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="G" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Google Calendar" Style="{StaticResource BodyStrong}"/>
                                <TextBlock x:Name="LibGoogleStatus" Style="{StaticResource Dim}" FontSize="12"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="LibGoogleConnectBtn" Style="{StaticResource PillButton}" Padding="20,9"
                                        Click="OnLibGoogleConnect"/>
                                <Button x:Name="LibGoogleDisconnectBtn" Style="{StaticResource PillButton}" Background="Transparent"
                                        Foreground="{DynamicResource Coral}" Content="Disconnect" Padding="16,9" Margin="8,0,0,0"
                                        ToolTip="Sign out of Google and remove the stored token" Click="OnLibGoogleDisconnect"/>
                            </StackPanel>
                        </Grid>

                        <!-- Outlook -->
                        <Grid x:Name="LibOutlookRow" Margin="0,18,0,0">
                            <!-- Three columns, not a horizontal stack: a StackPanel measures its
                                 children with INFINITE width, so a wrapping status line simply ran
                                 underneath the button instead of wrapping before it. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="LibOutlookMark" Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Chip}" Margin="0,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="O" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Outlook" Style="{StaticResource BodyStrong}"/>
                                <TextBlock x:Name="LibOutlookStatus" Style="{StaticResource Dim}" FontSize="12"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="LibOutlookConnectBtn" Style="{StaticResource PillButton}" Padding="20,9"
                                        Click="OnLibOutlookConnect"/>
                                <Button x:Name="LibOutlookDisconnectBtn" Style="{StaticResource PillButton}" Background="Transparent"
                                        Foreground="{DynamicResource Coral}" Content="Disconnect" Padding="16,9" Margin="8,0,0,0"
                                        ToolTip="Remove the stored Outlook token from this PC" Click="OnLibOutlookDisconnect"/>
                            </StackPanel>
                        </Grid>

                        <!-- ── About ── -->
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,28,0,24"/>
                        <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
                        <Border Margin="-8,8,-8,0" Padding="8,10" CornerRadius="10" Background="Transparent"
                                Cursor="Hand" MouseEnter="OnLibAboutHover" MouseLeave="OnLibAboutUnhover"
                                MouseLeftButtonUp="OnLibOpenSource">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Built with - open source &amp; licences" Style="{StaticResource BodyStrong}"/>
                                    <TextBlock Text="The open models and libraries that power Toki."
                                               Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>
