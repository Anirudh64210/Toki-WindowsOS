<Window x:Class="Toki.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Toki.Controls"
        Title="Toki — Library" Height="640" Width="940" MinWidth="680" MinHeight="440"
        WindowStartupLocation="Manual" Background="{DynamicResource Surface}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="308"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list of meetings + notes -->
        <DockPanel Grid.Column="0" Margin="20,16,14,16">
            <Button DockPanel.Dock="Top" x:Name="BackBtn" Style="{StaticResource PillButton}"
                    Content="‹  Back to Toki" HorizontalAlignment="Left" FontSize="11"
                    Background="{DynamicResource SurfaceHi}" Padding="12,6" Margin="0,0,0,14" Click="OnBack"/>
            <Grid DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Text="Library" Style="{StaticResource Body}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="CountLabel" Style="{StaticResource Dim}" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceHi}" CornerRadius="10"
                    Padding="12,0" Margin="0,14,0,0">
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                         VerticalContentAlignment="Center" Height="36" FontSize="12.5" TextChanged="OnSearch"/>
            </Border>
            <Button DockPanel.Dock="Top" Style="{StaticResource WhiteButton}" Content="+  New note"
                    Margin="0,10,0,0" Padding="0,9" HorizontalContentAlignment="Center" Click="OnNewNote"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" controls:SmoothScroll.Enabled="True">
                <StackPanel x:Name="Cards"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: detail. The content is capped to a fixed readable column (MaxWidth) so
             widening/maximising the window does NOT re-wrap every transcript line — the text
             width is identical restored vs maximised, so there's next to nothing to relayout
             and maximise snaps smoothly instead of the content lagging then popping to fill.
             Also just better typography than full-width lines. -->
        <Border Grid.Column="1" Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="28,24,28,24"
                          controls:SmoothScroll.Enabled="True">
                <StackPanel x:Name="Detail" MaxWidth="560" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
